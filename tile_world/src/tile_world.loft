//
// tile_world — an unbounded, layered square-grid world, and the traversal rules of a small
// puzzle game played in it.
//
// ── The memory model ─────────────────────────────────────────────────
//
// The world is a stack of LAYERS — `z` is the floor level, negative for dungeons and mines
// below the ground, positive for upper floors and mountain tops — and each layer is an
// unbounded 2-D grid.  Like hex_world and moros's map, a layer is held in 32x32 CHUNKS that
// exist only where something was set, found by their chunk coordinates; here through a hash
// keyed on (cx, cy, z), so a lookup costs the same in a world of ten chunks or ten million.
// Chunk coordinates are the floor of a coordinate over 32, so the world grows west and north
// of the origin as it does east and south.
//
// A cell's TERRAIN is two bytes: a kind (void, floor, wall, water, rail) in the top four bits
// and a tile number (the picture: grass, stone, a river bank) in the low twelve.  A chunk is
// 2 KB.  A cell nobody set is void.
//
// THINGS — carts, chairs, tables, rocks, anvils — move, so they are not in the terrain: each
// cell that holds any has a STACK (bottom first) in a second hash keyed on (x, y, z).  A stack
// is removed when it empties, so the things cost memory only where they are.
//
// ── The rules ────────────────────────────────────────────────────────
//
// Height counts in steps: a table is 2 high, a chair 1, and a layer 3 (`LAYER_HEIGHT`).  The
// hero stands at a height on its cell — 0 on the floor, 1 on a chair, 2 on a table, 3 on a
// chair on a table — and steps up at most 1 and down any amount.
//
// `walk(w, dx, dy)` moves the hero one cell:
//   - from height 3 onto the floor of the layer ABOVE, where that layer has one beside it
//     (a table with a chair on top is the way up a level), and from that floor, into the void
//     over such a stack, back down onto it (so a climb never strands the hero);
//   - not into a wall, water or the void;
//   - into a thing at the hero's own level, it PUSHES it one cell when the thing can go there,
//     and otherwise climbs onto it when it is a chair or a table no more than 1 higher.
// Carts move only along rails, and a line of carts on the rails moves as one TRAIN: the hero
// pushes a train of up to `push_strength` carts (3) and pulls one of up to `pull_strength` (2).
// Nothing else chains: a train stops at a rock, and a rock or an anvil — pushed onto empty floor
// or rail, where it blocks the carts — stops at a cart or another rock.  A chair goes onto empty
// floor, or along a row of tables at table height.
//
// `pull(w, dx, dy)` walks the hero one cell and drags what is behind it into the cell it left:
// a cart train along the rails, a chair anywhere it fits — up onto a table, too, when the hero
// pulls it from the floor while standing on the table.  A rock or an anvil is not pulled.
//
// A green POTION lies on the floor and is used by walking onto it: for a minute both strengths
// are 2 more.  The world keeps its own clock in milliseconds, which the game advances with
// `tick` — so a test sets time exactly.
//
// Handles and values: things and terrain kinds are small integers (the constants below);
// the hero is fields of the World.

// --- Terrain kinds ---
pub const VOID = 0;
pub const FLOOR = 1;
pub const WALL = 2;
pub const WATER = 3;
pub const RAIL = 4;

// --- Things ---
pub const CART = 1;
pub const CHAIR = 2;
pub const TABLE = 3;
pub const ROCK = 4;
pub const ANVIL = 5;
/// A green potion: lies on the floor, used by walking onto it.
pub const POTION = 6;
/// A wizard's staff: a light.  Fixed to a wall it is a torch; the hero carries one.
pub const STAFF = 7;

/// How many carts in a row the hero pushes, and pulls; a potion adds `POTION_BOOST` to each for
/// `POTION_MS` milliseconds.
pub const PUSH_STRENGTH = 3;
pub const PULL_STRENGTH = 2;
pub const POTION_BOOST = 2;
pub const POTION_MS = 60000;

/// How many height steps a layer is: from 3 (a chair on a table) the hero reaches the next.
pub const LAYER_HEIGHT = 3;

const CHUNK = 32;

// 32x32 cells of one layer: ck_cells[ly * 32 + lx] = kind * 4096 + tile.
struct Chunk {
  const cx: integer,
  const cy: integer,
  const z: integer,
  cells: vector<u16>
}

// The things on one cell, bottom first.
struct Stack {
  const x: integer,
  const y: integer,
  const z: integer,
  things: vector<integer>
}

/// The world: its chunks, its stacks and where the hero stands.
pub struct World {
  chunks: hash<Chunk[cx, cy, z]>,
  stacks: hash<Stack[x, y, z]>,
  pub hero_x: integer,
  pub hero_y: integer,
  pub hero_z: integer,
  pub hero_h: integer,
  /// The world's clock in milliseconds (`tick`), and until when a potion's strength lasts.
  pub now: integer,
  pub boost_until: integer,
  /// What the hero holds: 0 for nothing, or a thing (`STAFF`).
  pub hero_item: integer
}

/// What a step did.
pub enum Step {
  Blocked,
  Walked,
  Pushed,
  Pulled,
  Climbed,
  /// The hero took the staff off a wall, or fixed the one it held to a wall.
  Took,
  Placed
}

/// An empty world: every cell void, the hero at the origin of layer 0.
pub fn world() -> World {
  World { hero_x: 0, hero_y: 0, hero_z: 0, hero_h: 0, now: 0, boost_until: 0, hero_item: 0 }
}

// --- Addressing ---

/// floor(v / 32): the chunk a coordinate is in, west and north of the origin included.
pub fn chunk_of(v: integer) -> integer {
  if v >= 0 { v / CHUNK } else { -((CHUNK - 1 - v) / CHUNK) }
}

/// v mod 32 in [0, 31]: the coordinate inside its chunk.
pub fn inside(v: integer) -> integer {
  v - chunk_of(v) * CHUNK
}

/// How many chunks the world holds — the measure of its memory, 2 KB each.
pub fn chunk_count(w: const World) -> integer {
  len(w.chunks)
}

// --- Terrain ---

/// Set a cell's terrain: a kind and, for the picture, a tile number (0..4095).
pub fn set_terrain(w: World, x: integer, y: integer, z: integer, kind: integer, tile: integer = 0) {
  cx = chunk_of(x);
  cy = chunk_of(y);
  if !w.chunks[cx, cy, z] {
    w.chunks += [Chunk { cx: cx, cy: cy, z: z, cells: [0 as u16; CHUNK * CHUNK] }];
  }
  c = w.chunks[cx, cy, z];
  c.cells[inside(y) * CHUNK + inside(x)] = ((kind & 15) * 4096 + (tile & 4095)) as u16;
}

/// Set a rectangle of terrain, corners included.
pub fn fill(w: World, x0: integer, y0: integer, x1: integer, y1: integer, z: integer,
            kind: integer, tile: integer = 0) {
  for y in y0..=y1 {
    for x in x0..=x1 { set_terrain(w, x, y, z, kind, tile); }
  }
}

fn raw(w: const World, x: integer, y: integer, z: integer) -> integer {
  c = w.chunks[chunk_of(x), chunk_of(y), z];
  if !c { return 0; }
  (c.cells[inside(y) * CHUNK + inside(x)] ?? 0) as integer
}

/// A cell's terrain kind; void where nothing was set.
pub fn terrain(w: const World, x: integer, y: integer, z: integer) -> integer {
  raw(w, x, y, z) / 4096
}

/// A cell's tile number, its picture.
pub fn tile(w: const World, x: integer, y: integer, z: integer) -> integer {
  raw(w, x, y, z) % 4096
}

/// Can a cell be stood on or moved over: floor or rail.
pub fn walkable(kind: integer) -> boolean {
  kind == FLOOR || kind == RAIL
}

// --- Things ---

/// How many height steps a thing adds to its stack.
pub fn thing_height(thing: integer) -> integer {
  if thing == TABLE { 2 } else if thing == 0 || item(thing) { 0 } else { 1 }
}

/// Is this a thing the hero walks onto rather than into: a potion or a staff on the floor.
pub fn item(thing: integer) -> boolean {
  thing == POTION || thing == STAFF
}

/// Can the hero stand on this thing: a chair or a table.
pub fn standable(thing: integer) -> boolean {
  thing == CHAIR || thing == TABLE
}

/// Can a push move this thing: everything but a table.
pub fn movable(thing: integer) -> boolean {
  thing == CART || thing == CHAIR || thing == ROCK || thing == ANVIL
}

/// Put a thing on top of a cell's stack.
pub fn place(w: World, x: integer, y: integer, z: integer, thing: integer) {
  if !w.stacks[x, y, z] {
    w.stacks += [Stack { x: x, y: y, z: z, things: [] }];
  }
  s = w.stacks[x, y, z];
  s.things += [thing];
}

/// The things on a cell, bottom first.
pub fn things(w: const World, x: integer, y: integer, z: integer) -> vector<integer> {
  s = w.stacks[x, y, z];
  if !s { return []; }
  out: vector<integer> = [];
  for t in s.things { out += [t]; }
  out
}

/// The top thing on a cell, 0 when there is none.
pub fn top(w: const World, x: integer, y: integer, z: integer) -> integer {
  s = w.stacks[x, y, z];
  if !s { return 0; }
  n = len(s.things);
  if n == 0 { 0 } else { s.things[n - 1] ?? 0 }
}

/// The height of a cell's stack: what standing on top of it means.
pub fn height(w: const World, x: integer, y: integer, z: integer) -> integer {
  s = w.stacks[x, y, z];
  if !s { return 0; }
  h = 0;
  for t in s.things { h += thing_height(t); }
  h
}

// Take the top thing off a cell's stack; the stack goes when it empties.
fn take(w: World, x: integer, y: integer, z: integer) -> integer {
  s = w.stacks[x, y, z];
  if !s { return 0; }
  n = len(s.things);
  if n == 0 { return 0; }
  t = s.things[n - 1] ?? 0;
  if n == 1 {
    w.stacks[x, y, z] = null;
  } else {
    s.things = s.things[0..n - 1];
  }
  t
}

// --- The hero ---

/// Put the hero on a cell, standing on its stack.
pub fn put_hero(w: World, x: integer, y: integer, z: integer) {
  w.hero_x = x;
  w.hero_y = y;
  w.hero_z = z;
  w.hero_h = height(w, x, y, z);
}

// Can `thing`, sitting with its base at height `base`, go onto cell (x, y, z)?  The cell's
// surface must be that same height: a push or a pull moves a thing level, never up.
fn fits(w: const World, thing: integer, x: integer, y: integer, z: integer, base: integer) -> boolean {
  k = terrain(w, x, y, z);
  if !walkable(k) { return false; }
  surface = height(w, x, y, z);
  if surface != base { return false; }
  if thing == CART { return k == RAIL && surface == 0; }
  if thing == ROCK || thing == ANVIL { return surface == 0; }
  // A chair: onto the floor, or onto a table's top along a row of tables.
  surface == 0 || top(w, x, y, z) == TABLE
}

// Move the hero to (x, y, z), standing on the stack there.  A potion on that floor is used; a
// staff there is picked up, and what the hero held is put down in its place.
fn arrive(w: World, x: integer, y: integer, z: integer) {
  w.hero_x = x;
  w.hero_y = y;
  w.hero_z = z;
  w.hero_h = height(w, x, y, z);
  if w.hero_h == 0 && top(w, x, y, z) == POTION {
    take(w, x, y, z);
    w.boost_until = w.now + POTION_MS;
  } else if w.hero_h == 0 && top(w, x, y, z) == STAFF {
    take(w, x, y, z);
    if w.hero_item != 0 { place(w, x, y, z, w.hero_item); }
    w.hero_item = STAFF;
  }
}

// --- Strength and time ---

/// Advance the world's clock by `ms` milliseconds.
pub fn tick(w: World, ms: integer) {
  if ms > 0 { w.now += ms; }
}

/// Is a potion's strength still on?
pub fn boosted(w: const World) -> boolean {
  w.now < w.boost_until
}

/// How many carts the hero pushes in a row now, and pulls.
pub fn push_strength(w: const World) -> integer {
  PUSH_STRENGTH + (if boosted(w) { POTION_BOOST } else { 0 })
}

pub fn pull_strength(w: const World) -> integer {
  PULL_STRENGTH + (if boosted(w) { POTION_BOOST } else { 0 })
}

/// How many carts stand in a row from (x, y) on, a step (dx, dy) apart: the train a push or a
/// pull there moves.
pub fn train(w: const World, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> integer {
  n = 0;
  while top(w, x + n * dx, y + n * dy, z) == CART && height(w, x + n * dx, y + n * dy, z) == 1 {
    n += 1;
  }
  n
}

// The climb between layers, or null when this step is not one.
fn climb(w: World, dx: integer, dy: integer) -> Step? {
  tx = w.hero_x + dx;
  ty = w.hero_y + dy;
  z = w.hero_z;
  // Up: from a stack of 3 onto the floor of the layer above, beside it.
  if w.hero_h >= LAYER_HEIGHT && walkable(terrain(w, tx, ty, z + 1)) && top(w, tx, ty, z + 1) == 0 {
    arrive(w, tx, ty, z + 1);
    return Step.Climbed;
  }
  // Down: into the void over a stack of 3 on the layer below.
  if terrain(w, tx, ty, z) == VOID && walkable(terrain(w, tx, ty, z - 1))
      && height(w, tx, ty, z - 1) == LAYER_HEIGHT && standable(top(w, tx, ty, z - 1)) {
    arrive(w, tx, ty, z - 1);
    return Step.Climbed;
  }
  null
}

/// Move the hero one cell (dx, dy one of the four directions): walk, push, climb onto a thing,
/// or climb a layer.  The hero stays where it is when the step is Blocked.
pub fn walk(w: World, dx: integer, dy: integer) -> Step {
  c = climb(w, dx, dy);
  if c != null { return c ?? Step.Blocked; }
  tx = w.hero_x + dx;
  ty = w.hero_y + dy;
  z = w.hero_z;
  // A wall: take the staff fixed to it with an empty hand, or fix the held staff to a bare one.
  if terrain(w, tx, ty, z) == WALL {
    if top(w, tx, ty, z) == STAFF && w.hero_item == 0 {
      take(w, tx, ty, z);
      w.hero_item = STAFF;
      return Step.Took;
    }
    if top(w, tx, ty, z) == 0 && w.hero_item == STAFF {
      place(w, tx, ty, z, STAFF);
      w.hero_item = 0;
      return Step.Placed;
    }
  }
  if !walkable(terrain(w, tx, ty, z)) { return Step.Blocked; }
  thing = top(w, tx, ty, z);
  if thing == 0 || item(thing) {
    arrive(w, tx, ty, z);
    return Step.Walked;
  }
  surface = height(w, tx, ty, z);
  base = surface - thing_height(thing);
  // A train of carts moves as one, when the hero is strong enough and the rail after it is free.
  if thing == CART && w.hero_h == 0 {
    n = train(w, tx, ty, z, dx, dy);
    if n > push_strength(w) || !fits(w, CART, tx + n * dx, ty + n * dy, z, 0) {
      return Step.Blocked;
    }
    k = n - 1;
    while k >= 0 {
      take(w, tx + k * dx, ty + k * dy, z);
      place(w, tx + (k + 1) * dx, ty + (k + 1) * dy, z, CART);
      k -= 1;
    }
    arrive(w, tx, ty, z);
    return Step.Pushed;
  }
  // Any other thing at the hero's own level is pushed, when it can go one cell further.
  if movable(thing) && base == w.hero_h && fits(w, thing, tx + dx, ty + dy, z, base) {
    take(w, tx, ty, z);
    place(w, tx + dx, ty + dy, z, thing);
    arrive(w, tx, ty, z);
    return Step.Pushed;
  }
  // Otherwise a chair or a table no more than one step up is climbed onto.
  if standable(thing) && surface <= w.hero_h + 1 {
    arrive(w, tx, ty, z);
    return Step.Walked;
  }
  Step.Blocked
}

/// Walk one cell and drag the thing behind the hero into the cell it left: a cart along the
/// rails, a chair anywhere it fits there — up onto a table the hero stands on, too.  A rock or
/// an anvil stays.  Pulled when something came along, Walked when nothing did, Blocked when the
/// hero cannot take the step (the step must be a plain one, onto a cell no higher than the
/// hero stands).
pub fn pull(w: World, dx: integer, dy: integer) -> Step {
  fx = w.hero_x;
  fy = w.hero_y;
  z = w.hero_z;
  tx = fx + dx;
  ty = fy + dy;
  bx = fx - dx;
  by = fy - dy;
  if !walkable(terrain(w, tx, ty, z)) { return Step.Blocked; }
  target = top(w, tx, ty, z);
  if (target != 0 && !item(target) && !standable(target)) || height(w, tx, ty, z) > w.hero_h {
    return Step.Blocked;
  }
  thing = top(w, bx, by, z);
  // The cell the hero leaves: the dragged thing lands on its surface, which is where the hero
  // stood.
  left = height(w, fx, fy, z);
  base = height(w, bx, by, z) - thing_height(thing);
  if thing == CART {
    // The whole train behind follows, one cell each, when the hero can pull it.
    n = train(w, bx, by, z, -dx, -dy);
    can = left == 0 && terrain(w, fx, fy, z) == RAIL && top(w, fx, fy, z) == 0;
    strong = n <= pull_strength(w);
    arrive(w, tx, ty, z);
    if !can || !strong { return Step.Walked; }
    for k in 1..=n {
      take(w, fx - k * dx, fy - k * dy, z);
      place(w, fx - (k - 1) * dx, fy - (k - 1) * dy, z, CART);
    }
    return Step.Pulled;
  }
  ok = false;
  if thing == CHAIR {
    // Level, or lifted up to two steps — off the floor onto a table — or lowered.
    lift = left - base;
    ok = lift >= -2 && lift <= 2 && (left == 0 || top(w, fx, fy, z) == TABLE);
  }
  arrive(w, tx, ty, z);
  if !ok { return Step.Walked; }
  take(w, bx, by, z);
  place(w, fx, fy, z, thing);
  Step.Pulled
}

// --- Light ---

/// The darkest shade: a cell this many steps or more from every light.  Never black, so a
/// thing moving in the dark can still be seen.
pub const DARKEST = 7;

/// Is (x, y, z) under the open sky: nothing on the layer above it.  It is day, so the open
/// sky is always light.
pub fn open_sky(w: const World, x: integer, y: integer, z: integer) -> boolean {
  terrain(w, x, y, z + 1) == VOID
}

/// Is (x, y, z) a light: a cell under the open sky, a staff on it (on the floor, or fixed to
/// a wall), or the hero carrying a staff.
pub fn light_source(w: const World, x: integer, y: integer, z: integer) -> boolean {
  if terrain(w, x, y, z) == VOID { return false; }
  if w.hero_item == STAFF && w.hero_x == x && w.hero_y == y && w.hero_z == z { return true; }
  if open_sky(w, x, y, z) { return true; }
  for t in things(w, x, y, z) {
    if t == STAFF { return true; }
  }
  false
}

/// How dark each cell of (x0, y0) .. (x1, y1) on layer z is, row by row: 0 at a light, one
/// shade darker for each step from the nearest one, up to `DARKEST`.  Light spreads over
/// everything but walls: a wall is lit, but passes no light on (unless it holds the staff).
/// A light up to `DARKEST` cells outside the rectangle counts.
pub fn shades(w: const World, x0: integer, y0: integer, x1: integer, y1: integer,
              z: integer) -> vector<integer> {
  gx = x0 - DARKEST;
  gy = y0 - DARKEST;
  gw = x1 - x0 + 1 + 2 * DARKEST;
  gh = y1 - y0 + 1 + 2 * DARKEST;
  dist: vector<integer> = [DARKEST; gw * gh];
  queue: vector<integer> = [];
  for j in 0..gh {
    for i in 0..gw {
      if light_source(w, gx + i, gy + j, z) {
        dist[j * gw + i] = 0;
        queue += [j * gw + i];
      }
    }
  }
  at = 0;
  while at < len(queue) {
    c = queue[at] ?? 0;
    at += 1;
    d = dist[c] ?? DARKEST;
    if d + 1 >= DARKEST { continue; }
    cx = c % gw ?? 0;
    cy = c / gw ?? 0;
    if d > 0 && terrain(w, gx + cx, gy + cy, z) == WALL { continue; }
    for n in [(cx - 1, cy), (cx + 1, cy), (cx, cy - 1), (cx, cy + 1)] {
      nx = n.0;
      ny = n.1;
      if nx >= 0 && nx < gw && ny >= 0 && ny < gh && (dist[ny * gw + nx] ?? 0) > d + 1 {
        dist[ny * gw + nx] = d + 1;
        queue += [ny * gw + nx];
      }
    }
  }
  out: vector<integer> = [];
  for y in y0..=y1 {
    for x in x0..=x1 {
      out += [dist[(y - gy) * gw + (x - gx)] ?? DARKEST];
    }
  }
  out
}

// --- Views ---

fn glyph(w: const World, x: integer, y: integer, z: integer) -> text {
  if w.hero_x == x && w.hero_y == y && w.hero_z == z { return "@"; }
  t = top(w, x, y, z);
  if t == CART { return "c"; }
  if t == ROCK { return "o"; }
  if t == ANVIL { return "a"; }
  if t == POTION { return "g"; }
  if t == STAFF { return "i"; }
  if t == TABLE { return "T"; }
  if t == CHAIR {
    if height(w, x, y, z) >= LAYER_HEIGHT { return "H"; }
    return "h";
  }
  k = terrain(w, x, y, z);
  if k == FLOOR { return "."; }
  if k == WALL { return "#"; }
  if k == WATER { return "~"; }
  if k == RAIL { return "="; }
  " "
}

/// Layer `z` from (x0, y0) to (x1, y1) as text, one line per row: `@` the hero, `.` floor,
/// `#` wall, `~` water, `=` rail, ` ` void; `c` a cart, `h` a chair, `T` a table, `H` a chair
/// on a table, `o` a rock, `a` an anvil, `g` a green potion.
pub fn view(w: const World, x0: integer, y0: integer, x1: integer, y1: integer, z: integer) -> text {
  out = "";
  for y in y0..=y1 {
    for x in x0..=x1 { out += glyph(w, x, y, z); }
    out += "\n";
  }
  out
}

// --- Playing ---

/// Play a line of moves: `w` `a` `s` `d` walk north, west, south and east; `pw` `pa` `ps` `pd`
/// pull.  Moves are separated by spaces; anything else is skipped.  Answers how many moves were
/// not Blocked.
pub fn play(w: World, moves: text) -> integer {
  done = 0;
  for m in moves.split(' ') {
    t = m.trim();
    pulling = t.starts_with("p");
    d = if pulling { t[1..] } else { t };
    dx = if d == "a" { -1 } else if d == "d" { 1 } else { 0 };
    dy = if d == "w" { -1 } else if d == "s" { 1 } else { 0 };
    if dx == 0 && dy == 0 { continue; }
    step = if pulling { pull(w, dx, dy) } else { walk(w, dx, dy) };
    if step != Step.Blocked { done += 1; }
  }
  done
}

// --- A demo level ---

/// "The first climb", a small traversal puzzle (examples/first_climb.loft plays it):
///
///      x 0123456789012
///   y0   #############        @ hero, h chair, T table, c cart on the rail bridge,
///   y1   #@....~.....#        o rock on the rails, ~ river, = rails.
///   y2   #.....~..TT.#        Layer 1 has a ledge north of the tables, (8..11, 1).
///   y3   #.....~.....#
///   y4   #..===c=o==.#
///   y5   #.....~.....#
///   y6   #.h...~.....#
///   y7   #.....~.....#
///   y8   #############
///
/// Solved when the hero stands on layer 1 (`reached_ledge`).
pub fn first_climb() -> World {
  w = world();
  fill(w, 0, 0, 12, 8, 0, WALL);
  fill(w, 1, 1, 11, 7, 0, FLOOR);
  fill(w, 6, 1, 6, 7, 0, WATER);
  fill(w, 3, 4, 10, 4, 0, RAIL);
  place(w, 6, 4, 0, CART);
  place(w, 8, 4, 0, ROCK);
  place(w, 2, 6, 0, CHAIR);
  place(w, 9, 2, 0, TABLE);
  place(w, 10, 2, 0, TABLE);
  fill(w, 8, 0, 11, 0, 1, WALL);
  fill(w, 8, 1, 11, 1, 1, FLOOR);
  put_hero(w, 1, 1, 0);
  w
}

/// Is the hero up on the first climb's ledge?
pub fn reached_ledge(w: const World) -> boolean {
  w.hero_z == 1
}

/// "The cellar", a dark level: a corridor under a ceiling, its torch at the west end, a rock in
/// the way, and the daylight of an open yard at the east end.
///
///      x 0123456789012
///   y0   #############        @ hero, ! the staff fixed to the wall (a torch),
///   y1   !@...#.......        o rock.  Everything but the yard (x 12, open sky) has a
///   y2   #....o.......        ceiling: layer 1 is floor over it.
///   y3   #############
///
/// Solved when the hero stands in the yard (`in_daylight`).
pub fn the_cellar() -> World {
  w = world();
  fill(w, 0, 0, 12, 3, 0, WALL);
  fill(w, 1, 1, 11, 2, 0, FLOOR);
  set_terrain(w, 5, 1, 0, WALL);
  fill(w, 12, 1, 12, 2, 0, FLOOR);
  fill(w, 0, 0, 11, 3, 1, FLOOR);
  place(w, 0, 1, 0, STAFF);
  place(w, 5, 2, 0, ROCK);
  put_hero(w, 1, 1, 0);
  w
}

/// Is the hero out in the open, under the sky?
pub fn in_daylight(w: const World) -> boolean {
  open_sky(w, w.hero_x, w.hero_y, w.hero_z) && terrain(w, w.hero_x, w.hero_y, w.hero_z) != VOID
}

