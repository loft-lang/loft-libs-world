//
// The world model and its routines, over kinds a test declares: floor (walkable), wall
// (opaque), window (neither walkable nor opaque); a box (1 high, blocks), a lamp (a light,
// walked over), a curtain (opaque, walked through).  Every expected value is worked out by
// hand in its cell.
use tile_world;

const FLOOR = 1;
const WALL = 2;
const WINDOW = 3;
const BOX = 1;
const LAMP = 2;
const CURTAIN = 3;

fn kinds(w: tile_world::World) {
  tile_world::terrain_kind(w, FLOOR, true, false, false, ".");
  tile_world::terrain_kind(w, WALL, false, true, false, "#");
  tile_world::terrain_kind(w, WINDOW, false, false, false, "=");
  tile_world::thing_kind(w, BOX, 1, true, false, false, "b");
  tile_world::thing_kind(w, LAMP, 0, false, false, true, "*");
  tile_world::thing_kind(w, CURTAIN, 0, false, true, false, "|");
}

// A room x 0 .. 4, y 0 .. 2 on layer 0, walled round, under a ceiling (layer 1 set over it),
// so nothing is open sky.
fn room() -> tile_world::World {
  w = tile_world::world();
  kinds(w);
  tile_world::fill(w, -1, -1, 5, 3, 0, WALL);
  tile_world::fill(w, 0, 0, 4, 2, 0, FLOOR);
  tile_world::fill(w, -1, -1, 5, 3, 1, FLOOR);
  w
}

fn main() {
  w = tile_world::world();
  assert(tile_world::terrain(w, 5, 5, 0) == tile_world::VOID, "an empty world is void");
}

fn test_addressing() {
  assert(tile_world::chunk_of(0) == 0 && tile_world::chunk_of(31) == 0, "0 and 31 in chunk 0");
  assert(tile_world::chunk_of(32) == 1 && tile_world::chunk_of(-1) == -1, "32 in 1, -1 in -1");
  assert(tile_world::chunk_of(-32) == -1 && tile_world::chunk_of(-33) == -2, "-32 in -1, -33 in -2");
  assert(tile_world::inside(-1) == 31 && tile_world::inside(-33) == 31 && tile_world::inside(33) == 1,
         "slots 31, 31, 1");
}

// One cell far out and one on another layer make two chunks; a neighbour adds none.
fn test_sparse_layers() {
  w = tile_world::world();
  tile_world::set_terrain(w, -1000000, 7, 0, WINDOW, 12);
  tile_world::set_terrain(w, -1000000, 7, -3, FLOOR, 4095);
  assert(tile_world::chunk_count(w) == 2, "two chunks, got {tile_world::chunk_count(w)}");
  tile_world::set_terrain(w, -999999, 8, 0, FLOOR);
  assert(tile_world::chunk_count(w) == 2, "a neighbour in the same chunk adds none");
  assert(tile_world::terrain(w, -1000000, 7, 0) == WINDOW && tile_world::tile(w, -1000000, 7, 0) == 12, "kind and tile");
  assert(tile_world::tile(w, -1000000, 7, -3) == 4095, "the largest tile number");
  assert(tile_world::terrain(w, -1000000, 7, -2) == tile_world::VOID, "nothing in between");
}

// Heights add up as declared (a box 1, an undeclared thing 1, a lamp 0); take answers the top
// and the stack goes when it empties.
fn test_stacks() {
  w = room();
  tile_world::place(w, 1, 1, 0, BOX);
  tile_world::place(w, 1, 1, 0, BOX);
  tile_world::place(w, 1, 1, 0, LAMP);
  assert(tile_world::height(w, 1, 1, 0) == 2, "two boxes and a lamp: 2");
  tile_world::place(w, 2, 1, 0, 99);
  assert(tile_world::height(w, 2, 1, 0) == 1, "an undeclared thing is 1 high");
  assert(tile_world::take(w, 1, 1, 0) == LAMP && tile_world::top(w, 1, 1, 0) == BOX, "the lamp came off");
  _ = tile_world::take(w, 1, 1, 0);
  _ = tile_world::take(w, 1, 1, 0);
  assert(len(tile_world::things(w, 1, 1, 0)) == 0 && tile_world::take(w, 1, 1, 0) == 0, "empty");
}

fn test_passable() {
  w = room();
  tile_world::place(w, 1, 1, 0, BOX);
  tile_world::place(w, 2, 1, 0, LAMP);
  assert(tile_world::passable(w, 0, 0, 0), "floor");
  assert(!tile_world::passable(w, -1, 0, 0), "a wall");
  assert(!tile_world::passable(w, 9, 9, 0), "the void");
  assert(!tile_world::passable(w, 1, 1, 0), "a box blocks");
  assert(tile_world::passable(w, 2, 1, 0), "a lamp does not");
}

// A wall down x 2 for y 0 .. 1 leaves a gap at y 2.  From (0, 0) to (4, 0) every shortest walk
// goes through the gap: 4 steps east, 2 down and 2 back up, 8.
fn test_shortest_path_goes_round() {
  w = room();
  tile_world::fill(w, 2, 0, 2, 1, 0, WALL);
  p = tile_world::shortest_path(w, 0, 0, 4, 0, 0);
  assert(len(p) == 8, "8 steps, got {len(p)}");
  assert(p[7].0 == 4 && p[7].1 == 0, "ends at the goal");
  px = 0;
  py = 0;
  through_gap = false;
  for c in p {
    d = (c.0 - px) * (c.0 - px) + (c.1 - py) * (c.1 - py);
    assert(d == 1, "each step to a neighbour: {px},{py} -> {c.0},{c.1}");
    if c.0 == 2 && c.1 == 2 { through_gap = true; }
    px = c.0;
    py = c.1;
  }
  assert(through_gap, "through the gap at (2, 2)");
}

fn test_shortest_path_limits() {
  w = room();
  tile_world::fill(w, 2, 0, 2, 2, 0, WALL);
  assert(len(tile_world::shortest_path(w, 0, 0, 4, 0, 0)) == 0, "walled off: no path");
  v = room();
  tile_world::place(v, 3, 0, 0, BOX);
  p = tile_world::shortest_path(v, 0, 0, 3, 0, 0);
  assert(len(p) == 3 && p[2].0 == 3, "a path may end on a box: 3 steps");
  assert(len(tile_world::shortest_path(v, 0, 0, 4, 2, 0, 5)) == 0, "6 steps away, limit 5");
  assert(len(tile_world::shortest_path(v, 0, 0, 4, 2, 0, 6)) == 6, "limit 6 reaches it");
  assert(len(tile_world::shortest_path(v, 0, 0, 0, 0, 0)) == 0, "the start itself");
}

// Sight: a wall in between blocks; the wall itself is seen; a window and a lamp do not block,
// a curtain does.
fn test_line_of_sight() {
  w = room();
  assert(tile_world::line_of_sight(w, 0, 0, 4, 2, 0), "across the open room");
  tile_world::set_terrain(w, 2, 1, 0, WALL);
  assert(!tile_world::line_of_sight(w, 0, 1, 4, 1, 0), "the wall at (2, 1) is in the way");
  assert(tile_world::line_of_sight(w, 0, 1, 2, 1, 0), "the wall itself is seen");
  tile_world::set_terrain(w, 2, 1, 0, WINDOW);
  assert(tile_world::line_of_sight(w, 0, 1, 4, 1, 0), "a window is not");
  tile_world::place(w, 2, 1, 0, CURTAIN);
  assert(!tile_world::line_of_sight(w, 0, 1, 4, 1, 0), "a curtain is");
}

// Light along the room's row y 0, read from x -1 (the west wall) to x 5 (the east wall).
fn row(w: const tile_world::World, lights: const vector<(integer, integer)>) -> text {
  t = "";
  for s in tile_world::shades(w, -1, 0, 5, 0, 0, lights) { t += "{s},"; }
  t
}

fn test_shades() {
  w = room();
  none: vector<(integer, integer)> = [];
  assert(row(w, none) == "7,7,7,7,7,7,7,", "dark, never black");
  tile_world::place(w, 0, 0, 0, LAMP);
  assert(row(w, none) == "1,0,1,2,3,4,5,", "a lamp at x 0: {row(w, none)}");
  // A single wall cell at (2, 0) is walked round through row 1: (3, 0) is 5 steps from the lamp.
  tile_world::set_terrain(w, 2, 0, 0, WALL);
  assert(row(w, none) == "1,0,1,2,5,6,7,", "light goes round one wall cell: {row(w, none)}");
  // A whole wall down x 2 is lit and stops it.
  tile_world::fill(w, 2, 0, 2, 2, 0, WALL);
  assert(row(w, none) == "1,0,1,2,7,7,7,", "a wall at x 2 is lit and stops it: {row(w, none)}");
  carried: vector<(integer, integer)> = [(4, 0)];
  assert(row(w, carried) == "1,0,1,2,1,0,1,", "a light the game passes in, at x 4: {row(w, carried)}");
  tile_world::set_terrain(w, 4, 0, 1, tile_world::VOID);
  assert(row(w, none) == "1,0,1,2,1,0,1,", "the open sky over x 4 is a light: {row(w, none)}");
}

// Light along row y 0 from lights that start dimmer: the k-th light at shade `start[k]` (a torch
// burning down), a missing entry full.
fn dim_row(w: const tile_world::World, lights: const vector<(integer, integer)>,
           start: const vector<integer>) -> text {
  t = "";
  for s in tile_world::shades(w, -1, 0, 5, 0, 0, lights, start) { t += "{s},"; }
  t
}

fn test_dimmed_lights() {
  w = room();
  at0: vector<(integer, integer)> = [(0, 0)];
  assert(dim_row(w, at0, [3]) == "4,3,4,5,6,7,7,", "a light at x 0 from shade 3: {dim_row(w, at0, [3])}");
  // The dim one at x 0 keeps its 3 (the bright one at x 4 reaches it at 4); x 1 takes 3 from the
  // bright side.  The second light has no entry: full.
  both: vector<(integer, integer)> = [(0, 0), (4, 0)];
  assert(dim_row(w, both, [3]) == "4,3,3,2,1,0,1,", "the brighter way wins: {dim_row(w, both, [3])}");
  // A dim light on the wall itself (opaque) is a light: it spreads.
  wall: vector<(integer, integer)> = [(-1, 0)];
  assert(dim_row(w, wall, [2]) == "2,3,4,5,6,7,7,", "a wall light from shade 2: {dim_row(w, wall, [2])}");
  assert(dim_row(w, at0, [7]) == "7,7,7,7,7,7,7,", "as dark as the dark: nothing");
}

fn test_view() {
  w = room();
  tile_world::place(w, 1, 0, 0, BOX);
  tile_world::set_terrain(w, 3, 0, 0, WINDOW);
  marks: vector<(integer, integer, text)> = [(0, 0, "@")];
  got = tile_world::view(w, -1, 0, 5, 0, 0, marks);
  assert(got == "#@b.=.#\n", "got {got}");
}

// What a world holds, listed: layers lowest first, a layer's chunks in reading order, the
// cells with things layer by layer in reading order.  Chunks: (-1, 0) holds x -32 .. -1.
fn test_enumeration() {
  w = tile_world::world();
  kinds(w);
  tile_world::set_terrain(w, 40, 5, 2, FLOOR);
  tile_world::set_terrain(w, -1, 5, 0, FLOOR);
  tile_world::set_terrain(w, 3, 70, 0, FLOOR);
  tile_world::set_terrain(w, 3, 3, 0, WALL);
  tile_world::set_terrain(w, 0, 0, -1, FLOOR);
  ls = "";
  for z in tile_world::layers(w) { ls += "{z},"; }
  assert(ls == "-1,0,2,", "layers {ls}");
  cs = "";
  for c in tile_world::chunks(w, 0) { cs += "({c.0},{c.1})"; }
  assert(cs == "(-1,0)(0,0)(0,2)", "layer 0's chunks {cs}");
  assert(len(tile_world::chunks(w, 5)) == 0, "an empty layer has none");
  tile_world::place(w, 3, 3, 0, BOX);
  tile_world::place(w, 1, 9, 0, LAMP);
  tile_world::place(w, 2, 3, 0, BOX);
  tile_world::place(w, 0, 0, -1, BOX);
  ss = "";
  for s in tile_world::stacks(w) { ss += "({s.0},{s.1},{s.2})"; }
  assert(ss == "(0,0,-1)(2,3,0)(3,3,0)(1,9,0)", "stacks {ss}");
}
