//
// "The first climb" — a small traversal puzzle in tile_world, played in the terminal.
//
//   ~ river   = rails   c cart   o rock   h chair   T table   g potion   # wall   @ you
//
// Reach the ledge above the tables (layer 1).  Moves: w a s d to walk (and push), pw pa ps pd
// to walk and pull what is behind you; several per line, separated by spaces.  An empty line
// quits.
//
//   loft examples/first_climb.loft
use tile_world;

fn main() {
  w = tile_world::first_climb();
  println("The first climb — reach the ledge above the tables.  w a s d walk, pw pa ps pd pull.");
  last = ticks();
  while !tile_world::reached_ledge(w) {
    print(tile_world::view(w, 0, 0, 12, 8, w.hero_z));
    boost = if tile_world::boosted(w) { ", strong for {(w.boost_until - w.now) / 1000} s" } else { "" };
    println("height {w.hero_h}, layer {w.hero_z}{boost} >");
    line = host_input(600000);
    t = ticks();
    tile_world::tick(w, (t - last) / 1000);
    last = t;
    if line.trim() == "" { break; }
    tile_world::play(w, line);
  }
  if tile_world::reached_ledge(w) {
    print(tile_world::view(w, 7, 0, 12, 2, 1));
    println("You stand on the ledge.  Well climbed.");
  }
}
