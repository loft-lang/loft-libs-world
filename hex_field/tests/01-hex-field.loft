// hex_field: the exact-integer contract, asserted standalone.
//
// These are the CONTRACT tests — the guarantees a consumer (the game, the in-world
// editor) is entitled to rely on. They are deliberately self-contained: crawler keeps
// its own golden-JSON diff against the Python oracle, because that is a CONSUMER's
// check of this package, not this package's check of itself.
use hex_field::*;

fn main() {
  s = hexset_new(16);
  hexdisk_into(s, 8, 8, 2);
  assert(hexset_count(s) == 19, "hexdisk N=2 is 19 cells");
}

// I-ROUNDTRIP: outline and cell set can never disagree.
//   sum of the integer shoelace over all loops == 12 * (number of hexes)
fn test_area_roundtrip_is_exact() {
  ok = true;
  for n in 0..5 {
    s = hexset_new(32);
    hexdisk_into(s, 16, 16, n);
    v = trace(s);
    if shoelace_total(v) != 12 * hexset_count(s) { ok = false; }
  }
  assert(ok, "shoelace total == 12 * cell count, for every hexdisk radius");
}

// The validator must pass every traced form it produced itself.
fn test_validator_accepts_traced_forms() {
  ok = true;
  for n in 1..5 {
    s = hexset_new(32);
    hexdisk_into(s, 16, 16, n);
    v = trace(s);
    if validate(v, hexset_count(s)) != 0 { ok = false; }
  }
  assert(ok, "validate() == 0 on forms this package traced");
}

// Vertices are INTEGER lattice points — the property the whole design rests on.
// Cell centres satisfy k == m (mod 2); no float, no epsilon, no drift.
fn test_lattice_is_integral() {
  ok = true;
  for r in 0..12 {
    for q in 0..12 {
      k = lattice_k(q, r);
      m = lattice_m(q, r);
      if ((k - m) % 2) != 0 { ok = false; }
    }
  }
  assert(ok, "every cell centre satisfies k == m (mod 2)");
}

// Occupancy round-trips, and out-of-chunk reads are false rather than a crash.
fn test_hexset_setget_and_bounds() {
  s = hexset_new(8);
  hexset_set(s, 3, 4, true);
  assert(hexset_get(s, 3, 4), "set then get");
  assert(!hexset_get(s, 4, 4), "an untouched cell is empty");
  assert(!hexset_get(s, 99, 99), "out of chunk reads false, not a crash");
}

// NEGATIVE CONTROL: the area invariant must FAIL when the set is corrupted by one
// cell without re-tracing. A gate that cannot go red is not a gate.
fn test_negative_control_detects_one_cell() {
  s = hexset_new(32);
  hexdisk_into(s, 16, 16, 3);
  v = trace(s);
  hexset_set(s, 16, 16 + 9, true);          // a detached cell, outline NOT re-traced
  assert(shoelace_total(v) != 12 * hexset_count(s),
         "one added cell must break the area round-trip");
}

// `trace_edges` is `trace` with each edge's two cells kept: the same corners, loops and starts,
// exactly, and every edge between a cell of the set and one outside it, ending where the next
// begins.  Over a disk, a circle, an octagon, a ring round a hole, a wall one cell wide between
// a hole and the outside, and two pieces.
fn test_trace_edges_is_trace_with_the_cells() {
  forms: vector<HexSet> = [];
  d = hexset_new(32);
  hexdisk_into(d, 16, 16, 4);
  forms += [d];
  forms += [form_circle(40, 9.5)];
  forms += [form_octagon(40, 8.0)];
  ring = hexset_new(32);
  hexdisk_into(ring, 16, 16, 5);
  for hr in 14..19 { for hq in 14..19 { if hex_dist(hq, hr, 16, 16) <= 2 { hexset_set(ring, hq, hr, false); } } }
  forms += [ring];
  thin = hexset_new(32);
  hexdisk_into(thin, 16, 16, 2);
  hexset_set(thin, 16, 16, false);
  hexset_set(thin, 17, 16, false);
  forms += [thin];
  two = hexset_new(40);
  hexdisk_into(two, 10, 10, 3);
  hexdisk_into(two, 28, 27, 2);
  hexset_set(two, 3, 30, true);
  forms += [two];
  for fi in 0..len(forms) {
    s = forms[fi]!;
    v = trace(s);
    e = trace_edges(s);
    assert(e.em_loops == v.vm_loops, "form {fi}: {e.em_loops} loops, trace has {v.vm_loops}");
    assert(e.em_k == v.vm_k && e.em_m == v.vm_m && e.em_start == v.vm_start, "form {fi}: the corners and starts are trace's");
    assert(e.em_loops >= 1 && len(e.em_k) >= 6, "form {fi}: something traced");
    for li in 0..e.em_loops {
      a = e.em_start[li] ?? 0;
      b = e.em_start[li + 1] ?? 0;
      for j in a..b {
        qa = e.em_qa[j] ?? 0;
        ra = e.em_ra[j] ?? 0;
        qb = e.em_qb[j] ?? 0;
        rb = e.em_rb[j] ?? 0;
        assert(hexset_get(s, qa, ra) && !hexset_get(s, qb, rb), "form {fi} edge {j}: a cell inside, a cell outside");
        assert(hex_dist(qa, ra, qb, rb) == 1, "form {fi} edge {j}: neighbours");
        // the edge's two corners are corners of both its cells: 4 x the squared distance to each centre is 4
        nx = if j + 1 < b { j + 1 } else { a };
        for c in [j, nx] {
          for side in 0..2 {
            cq = if side == 0 { qa } else { qb };
            cr = if side == 0 { ra } else { rb };
            dk = (e.em_k[c] ?? 0) - lattice_k(cq, cr);
            dm = (e.em_m[c] ?? 0) - lattice_m(cq, cr);
            assert(3 * dk * dk + dm * dm == 4, "form {fi} edge {j}: its corners are its cells' corners");
          }
        }
      }
    }
  }
}
