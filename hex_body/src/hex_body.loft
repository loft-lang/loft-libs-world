// hex_body — HEXBODY'S OWN BODY MODEL: rigs, revolute joints with computed limits, pure poses, proxies.
//
// `G1`, the first brick of the body half (`plans/m1-moving-body/`).  The load-bearing decision,
// from the user: **a body is a RIG — bones and the limits in the joints between them, never a
// pose** (`SPEC` **I-POSE**).  So this module never stores a pose; it COMPUTES one from the current
// joint values, and that computation is a **pure function** (`SPEC` **I6**).  Purity is not a
// testability nicety here — it IS the scope boundary `L15` draws: hexbody answers *where a part is
// NOW*, never *what it will do*, and a pose that depended on history would have smuggled in a
// future.
//
// Re-measured from crawler's `hexwheel`/`wheeltest` (`T2 → T1`): the wheel's rolling identity holds
// **by construction, not by tuning**, because the joint value is computed FROM travel rather than
// accumulated.  Its own framing — *"phase is computed from the distance, so `Δφ·2πr = Δd` holds by
// construction"* — is exactly `I6`.  ⚠ **Flex is joints, not deformation** (`I-POSE`): a part that
// bends is more bones on more joints, so this survives a flexing wing unchanged and hexbody needs
// no skinning.

const TAU = 6.283185307179586;   // one turn, in radians

fn fabs(x: float) -> float { if x < 0.0 { 0.0 - x } else { x } }

// A REVOLUTE JOINT: its current value (in TURNS — a value of 1.0 is one revolution, the number a
// contact point actually cares about) and its LIMITS.  The limits are the joint's `fits?` doorstep
// (`K-FIT`): a joint value is ORDINAL, so a refusal owes an OFFER of the nearest admissible — unlike
// a material id, which is nominal and offers nothing (`X68`).
pub struct Joint {
  jt_value: float,   // the joint value, in turns
  jt_lo:    float,   // limit low  (turns)
  jt_hi:    float,   // limit high (turns)
}

pub fn joint_new(value: float, lo: float, hi: float) -> Joint {
  Joint { jt_value: value, jt_lo: lo, jt_hi: hi }
}

// FORWARD KINEMATICS (phase B): a point `(lx, ly)` in a part's LOCAL frame, posed by rotating it
// through the joint's angle.  A PURE FUNCTION of `(value, lx, ly)` — it reads no stored state, no
// elapsed time, no call count, and no previous value.  Two different paths to the same `value`
// therefore give byte-identical output, which is `I6` and the precondition for `I9`'s replay.
pub fn pose_of(value: float, lx: float, ly: float) -> (float, float) {
  th = value * TAU;
  c = cos(th);
  s = sin(th);
  (lx * c - ly * s, lx * s + ly * c)
}

// A WHEEL is a revolute joint whose value is DERIVED from how far it has travelled (phase C):
// `value = travel / (2πr)`.  Because the value is a function of travel and not an accumulation of
// steps, the no-slip identity is exact by construction.  `slip` is the deliberate defect knob —
// 0 for a true roll; non-zero is a skid, and it is the control that keeps `wheel_skid` honest.
pub fn wheel_value(travel: float, radius: float, slip: float) -> float {
  if radius < 0.000000001 { return 0.0; }
  (1.0 + slip) * (travel / (TAU * radius) ?? 0.0)
}

// The joint value as an ANGLE in radians.
pub fn wheel_angle(value: float) -> float { value * TAU }

// THE SKID — the contact point's slip, `|r·θ − travel|`.  For a value derived by `wheel_value`
// with `slip = 0` this is **machine-ε, not algebraic zero** — and that distinction was measured,
// not assumed: `travel → value → r·θ` is a float round-trip (a divide by `2πr` then a multiply by
// it), which f64 does not close bit-for-bit, so the residual is ~1 ulp of `travel`.  This is the
// BODY'S SOLE FLOAT STEP — the wheel's `ε_seam` (`SPEC` **I-FSEAM**, `X53`): the pose/roll
// computation is exactly where imprecision is licensed, bounded by machine ε and nowhere else.
// It is NOT a `P4` violation: `P4` governs the R1 geometry round trip, which is integer and exact;
// a wheel's roll is kinematics, which is the float frame.  Drive `θ` independently of `travel` —
// the spec's *"spin a wheel off-travel"* — and the skid is a real distance, orders of magnitude
// above ε.
pub fn wheel_skid(radius: float, value: float, travel: float) -> float {
  fabs(radius * wheel_angle(value) - travel)
}

// THE DOORSTEP (`K-FIT` for a joint): a value inside the joint's limits fits.
pub fn joint_fits(j: Joint, value: float) -> boolean {
  value >= j.jt_lo && value <= j.jt_hi
}

// The OFFER a refusal owes — the nearest admissible value.  A joint value is ordinal, so clamping
// to the limit is a real correction the editor can show, not a silent snap to a different thing.
pub fn joint_offer(j: Joint, value: float) -> float {
  if value < j.jt_lo { return j.jt_lo; }
  if value > j.jt_hi { return j.jt_hi; }
  value
}

// The residual an offer carries — how far the requested value was from admissible.
pub fn joint_residual(j: Joint, value: float) -> float {
  fabs(value - joint_offer(j, value))
}

// ── THE RIG, AND ITS CANONICAL TEXT (phase A of plans/m1-moving-body) ────────
//
// A body's `original` is a RIG — `⟨bones, joint limits⟩`, never a pose (`SPEC` **I-POSE**).  A
// bone is a segment with a **joint at its base** connecting it to its PARENT bone; the root bone
// has no parent.  This is the shape a **flexing wing** takes: not a soft bone but more bones on
// more joints, so the rig is a tree and the flex is joint values along it (`I-POSE`).
//
// The rig is a DESCRIPTION, so it round-trips like a stencil's `Form`: `write(read(R)) = R`
// **byte-for-byte**, and a malformed text is REFUSED rather than repaired.  A rig carries floats
// (offsets, lengths, joint limits), and the float↔text round trip is byte-exact in loft, so the
// text is exact with no tolerance (`I-EXACT`/`P4`: content we authored recovers exactly).
//
// INDEX ORDER IS THE CANONICAL LABELLING.  A tree can be relabelled and describe the same rig; the
// canonical form fixes the labels by requiring **topological order** — the root is bone 0 and every
// bone's parent is an EARLIER bone.  The parser enforces it (a bone out of order, or referring to a
// forward/absent parent, is refused), the same way `form_read` fixes the start corner by index
// order (`C2`).  Fuller canonicalisation — collapsing every relabelling — is the census-shaped
// problem `S5`–`S8` solved for forms; phase A's contract is the byte round trip, which topological
// order plus a strict parser delivers.

// ── THE THIRD DIMENSION (`G1b`) — an explicit axis, and an `oz` ──────────────
//
// A revolute joint in a PLANE needs no axis: there is only one, `+z`, and the
// 2-D code leaves it implicit by ADDING joint angles.  In space it has to be
// said, and `hex_part::Hinge` already says it with the same eight numbers —
// `{ox, oy, oz, ax, ay, az, lo, hi}`, of which the planar rig's are the six
// minus two.  So this extension unifies two libraries that already agree on
// units (TURNS) and on convention, rather than inventing a third shape.
//
// ⚠ **THE AXIS IS STORED AS GIVEN AND IS NOT NORMALISED**, which is
// `hex_part/hinge.loft`'s rule kept verbatim: *"the length of the axis carries
// no meaning; a consumer that needs a unit vector normalises where it needs
// one"*.  `rig_world_seg3` is that consumer and normalises at use.
//
// ⚠⚠ **A PLANAR RIG IS BIT-IDENTICAL, AND ONLY A SINGLE BONE IS** — measured
// before this was written, because it is the claim the whole extension rests
// on.  `rig_world_seg` composes by ADDING ANGLES (`th = pth + v`, then one
// `cos`/`sin`); any 3-D form composes ROTATIONS, and `cos(a+b)` is not
// `cos a cos b - sin a sin b` bit-for-bit in f64.  Over a five-bone planar
// chain at awkward angles:
//
//     quaternion form   0 of 5 bones identical, worst 6.7e-16 m
//     matrix form       the ROOT identical,     worst 2.2e-16 m
//
// so the matrix is what shipped.  ⚠ The quaternion's root fails for a reason
// worth keeping: it stores `cos(theta/2)` and rebuilds the rotation through
// double-angle arithmetic, where Rodrigues at `(0,0,1)` collapses to exactly
// `[[c,-s,0],[s,c,0],[0,0,1]]` with `c` and `s` untouched.  ⚠ And the axis
// `(0,0,1)` has length exactly 1.0, so normalising it divides by 1.0 and does
// not disturb that — gated, not assumed.
//
// ⚠ `rig_world_seg` IS UNCHANGED.  Re-expressing it through the 3-D path would
// have moved every existing consumer's numbers by an ulp to buy nothing.

pub struct Rig {
  rg_parent: vector<integer>,   // parent bone index; -1 for the root
  rg_ox:     vector<float>,     // joint offset in the parent's frame (x)
  rg_oy:     vector<float>,     // joint offset in the parent's frame (y)
  rg_oz:     vector<float>,     // joint offset in the parent's frame (z) — 0 in a planar rig
  rg_len:    vector<float>,     // the bone's length from its joint, along its own +x
  rg_ax:     vector<float>,     // the revolute axis, AS GIVEN — see above
  rg_ay:     vector<float>,     //   "
  rg_az:     vector<float>,     //   " — (0,0,1) in a planar rig: the implicit axis made explicit
  rg_lo:     vector<float>,     // the joint's limit low  (turns)
  rg_hi:     vector<float>,     // the joint's limit high (turns)
}

pub fn rig_new() -> Rig {
  Rig { rg_parent: [], rg_ox: [], rg_oy: [], rg_oz: [], rg_len: [],
        rg_ax: [], rg_ay: [], rg_az: [], rg_lo: [], rg_hi: [] }
}

// Append one bone in SPACE, growing the rig's parallel field vectors in place.
//
// ⚠ Eleven parameters is the eight of `hex_part::Hinge` plus a parent, a length
// and the rig — the family's own shape rather than a shorter one invented here.
pub fn rig_bone3(r: Rig, parent: integer, ox: float, oy: float, oz: float, len: float,
                 ax: float, ay: float, az: float, lo: float, hi: float) -> Rig {
  r.rg_parent += [parent];
  r.rg_ox += [ox]; r.rg_oy += [oy]; r.rg_oz += [oz]; r.rg_len += [len];
  r.rg_ax += [ax]; r.rg_ay += [ay]; r.rg_az += [az];
  r.rg_lo += [lo]; r.rg_hi += [hi];
  r
}

// Append one bone in the PLANE — the special case, and its signature is
// unchanged from 0.1.0.  A planar bone is one at `oz = 0` about `(0, 0, 1)`,
// which is exactly the axis the 2-D code left implicit.
pub fn rig_bone(r: Rig, parent: integer, ox: float, oy: float, len: float,
                lo: float, hi: float) -> Rig {
  rig_bone3(r, parent, ox, oy, 0.0, len, 0.0, 0.0, 1.0, lo, hi)
}

pub fn rig_count(r: Rig) -> integer { len(r.rg_parent) }

// Does bone `i` lie in the plane the 2-D rig assumes?  ⚠ It is asked with `==`
// and no tolerance, because it decides which RECORD the bone is written as and
// a near-planar bone must not be written as a planar one.
pub fn bone_planar(r: Rig, i: integer) -> boolean {
  (r.rg_oz[i] ?? 0.0) == 0.0 && (r.rg_ax[i] ?? 0.0) == 0.0
    && (r.rg_ay[i] ?? 0.0) == 0.0 && (r.rg_az[i] ?? 0.0) == 1.0
}

// Is the whole rig planar?  The question `rig_world_seg` implicitly asks of
// every rig it is handed, made available to a caller that wants to know.
pub fn rig_planar(r: Rig) -> boolean {
  for i in 0..len(r.rg_parent) {
    if !bone_planar(r, i) { return false; }
  }
  true
}

// The joint at bone `i`, as a `Joint` carrying its limits (value defaults to 0 — the neutral pose).
pub fn rig_joint(r: Rig, i: integer) -> Joint {
  joint_new(0.0, r.rg_lo[i] ?? 0.0, r.rg_hi[i] ?? 0.0)
}

// ADMISSIBLE — topological (root is bone 0 with parent -1, every other parent is earlier), and
// every joint limit is ordered `lo <= hi`.  This is the rig's doorstep: `fits?` for a whole rig.
pub fn rig_admissible(r: Rig) -> boolean {
  n = len(r.rg_parent);
  if n == 0 { return false; }
  if (r.rg_parent[0] ?? 0) != -1 { return false; }
  for i in 0..n {
    p = r.rg_parent[i] ?? 0;
    if i == 0 {
      if p != -1 { return false; }
    } else {
      if p < 0 || p >= i { return false; }        // parent must be an EARLIER bone
    }
    if (r.rg_lo[i] ?? 0.0) > (r.rg_hi[i] ?? 0.0) { return false; }
    // ⚠ AN AXIS OF ZERO LENGTH IS A JOINT WITH NOTHING TO TURN ABOUT —
    // `hex_part::HG_AXIS`, and asked the same way `moros_sim::has_axis` asks
    // it: one component non-zero, never a normalised length.  It is a
    // validation the planar rig had no way to express, because there the axis
    // was implicit and could not be got wrong.
    if (r.rg_ax[i] ?? 0.0) == 0.0 && (r.rg_ay[i] ?? 0.0) == 0.0
       && (r.rg_az[i] ?? 0.0) == 0.0 { return false; }
  }
  true
}

// ── THE FORMAT, AND WHY A SPATIAL BONE CHANGES ITS RECORD TAG ────────────────
//
// A planar bone writes exactly the bytes 0.1.0 wrote, so **a planar rig
// round-trips byte-identically across the version** and every rig on disk today
// still reads.
//
// ⚠⚠ A spatial bone writes `bone3` rather than a longer `bone` line, and that
// is the whole compatibility decision — MEASURED against the shipped 0.1.0
// reader rather than reasoned about:
//
//     extra words appended to a `bone` line  ->  0.1.0 reads 1 bone
//     the same rig under the tag `bone3`     ->  0.1.0 reads 0 bones
//
// 0.1.0's parser checks the keywords it knows and never the word COUNT, so
// appending fields makes an old reader silently return the bone's PLANAR
// PROJECTION — a rig quietly flattened, which is exactly the failure this
// library's *"a lenient reader would void the byte diff"* rule exists to stop.
// A new tag makes the same reader refuse the whole rig, which `rig_admissible`
// then rejects.  Loud beats tidy.
pub fn rig_write(r: Rig, name: text) -> text {
  n = len(r.rg_parent);
  s = "rig {name} bones {n}";
  for bi in 0..n {
    if bone_planar(r, bi) {
      s = s + "\nbone {bi} parent {r.rg_parent[bi] ?? 0} at {r.rg_ox[bi] ?? 0.0} {r.rg_oy[bi] ?? 0.0}"
          + " len {r.rg_len[bi] ?? 0.0} lim {r.rg_lo[bi] ?? 0.0} {r.rg_hi[bi] ?? 0.0}";
    } else {
      s = s + "\nbone3 {bi} parent {r.rg_parent[bi] ?? 0}"
          + " at {r.rg_ox[bi] ?? 0.0} {r.rg_oy[bi] ?? 0.0} {r.rg_oz[bi] ?? 0.0}"
          + " len {r.rg_len[bi] ?? 0.0}"
          + " axis {r.rg_ax[bi] ?? 0.0} {r.rg_ay[bi] ?? 0.0} {r.rg_az[bi] ?? 0.0}"
          + " lim {r.rg_lo[bi] ?? 0.0} {r.rg_hi[bi] ?? 0.0}";
    }
  }
  s
}

fn rig_word(line: text, i: integer) -> text {
  parts = line.split(' ');
  parts[i] ?? ""
}
fn rig_word_int(line: text, i: integer) -> integer { rig_word(line, i) as integer ?? 0 }
fn rig_word_float(line: text, i: integer) -> float { rig_word(line, i) as float ?? 0.0 }

// STRICT PARSER — accepts exactly what `rig_write` emits, refuses anything else by returning an
// empty rig (which `rig_admissible` then rejects).  A lenient reader would void the byte diff.
pub fn rig_read(t: text) -> Rig {
  lines = t.split('\n');
  nl = len(lines);
  if nl < 1 { return rig_new(); }
  head = lines[0] ?? "";
  if rig_word(head, 0) != "rig" { return rig_new(); }
  if rig_word(head, 2) != "bones" { return rig_new(); }
  nb = rig_word_int(head, 3);
  if nl != nb + 1 { return rig_new(); }
  out = rig_new();
  for ri in 1..nl {
    ln = lines[ri] ?? "";
    tag = rig_word(ln, 0);
    if rig_word_int(ln, 1) != ri - 1 { return rig_new(); }     // index order, like form C2
    if rig_word(ln, 2) != "parent" { return rig_new(); }
    if tag == "bone" {
      if rig_word(ln, 4) != "at" { return rig_new(); }
      if rig_word(ln, 7) != "len" { return rig_new(); }
      if rig_word(ln, 9) != "lim" { return rig_new(); }
      out = rig_bone(out, rig_word_int(ln, 3), rig_word_float(ln, 5), rig_word_float(ln, 6),
                     rig_word_float(ln, 8), rig_word_float(ln, 10), rig_word_float(ln, 11));
    } else if tag == "bone3" {
      if rig_word(ln, 4) != "at" { return rig_new(); }
      if rig_word(ln, 8) != "len" { return rig_new(); }
      if rig_word(ln, 10) != "axis" { return rig_new(); }
      if rig_word(ln, 14) != "lim" { return rig_new(); }
      out = rig_bone3(out, rig_word_int(ln, 3),
                      rig_word_float(ln, 5), rig_word_float(ln, 6), rig_word_float(ln, 7),
                      rig_word_float(ln, 9),
                      rig_word_float(ln, 11), rig_word_float(ln, 12), rig_word_float(ln, 13),
                      rig_word_float(ln, 15), rig_word_float(ln, 16));
    } else {
      return rig_new();                                        // an unknown record, refused
    }
  }
  out
}

// Byte-exact equality — floats compared with `==`, no tolerance (`I-EXACT`).
pub fn rig_eq(a: Rig, b: Rig) -> boolean {
  n = len(a.rg_parent);
  if len(b.rg_parent) != n { return false; }
  for ei in 0..n {
    if (a.rg_parent[ei] ?? 0) != (b.rg_parent[ei] ?? 0) { return false; }
    if (a.rg_ox[ei] ?? 0.0) != (b.rg_ox[ei] ?? 0.0) { return false; }
    if (a.rg_oy[ei] ?? 0.0) != (b.rg_oy[ei] ?? 0.0) { return false; }
    if (a.rg_oz[ei] ?? 0.0) != (b.rg_oz[ei] ?? 0.0) { return false; }
    if (a.rg_len[ei] ?? 0.0) != (b.rg_len[ei] ?? 0.0) { return false; }
    if (a.rg_ax[ei] ?? 0.0) != (b.rg_ax[ei] ?? 0.0) { return false; }
    if (a.rg_ay[ei] ?? 0.0) != (b.rg_ay[ei] ?? 0.0) { return false; }
    if (a.rg_az[ei] ?? 0.0) != (b.rg_az[ei] ?? 0.0) { return false; }
    if (a.rg_lo[ei] ?? 0.0) != (b.rg_lo[ei] ?? 0.0) { return false; }
    if (a.rg_hi[ei] ?? 0.0) != (b.rg_hi[ei] ?? 0.0) { return false; }
  }
  true
}

// ── THE COLLISION PROXY (phase D of plans/m1-moving-body) ────────────────────
//
// The project's founding claim, applied to the body: **a collision proxy is DERIVED from the
// geometry itself**, not hand-authored.  A rig's geometry is its posed BONE SEGMENTS, so the proxy
// is derived from those: each bone's SHAPE is the capsule (all points within a half-width `w` of
// its segment), and its PROXY is the oriented box that bounds the capsule.  `SPEC` **I4**: a proxy
// **⊇** its shape (never misses an overlap) and its overshoot is **bounded and stated**.
//
// The whole-body pose is FORWARD KINEMATICS up the tree — each bone's world frame composes its
// parent's frame with its joint value — and it is a **PURE FUNCTION of the joint values** (`I6`),
// because it composes `pose_of`, which is pure.  A flexing wing (more bones on more joints, `I-POSE`)
// poses the same way; nothing here deforms.

// The world segment of bone `i` at the given joint values: `(x0, y0)` its base, `(x1, y1)` its tip.
// Composes the tree from the root (bones are topological, so ancestors are computed first).
pub fn rig_world_seg(r: Rig, values: vector<float>, i: integer) -> (float, float, float, float) {
  n = i + 1;
  bx: vector<float> = [];
  by: vector<float> = [];
  th: vector<float> = [];
  for k in 0..n {
    v = values[k] ?? 0.0;
    p = r.rg_parent[k] ?? -1;
    if p < 0 {
      bx += [0.0]; by += [0.0]; th += [v];
    } else {
      pth = th[p] ?? 0.0;
      (rx, ry) = pose_of(pth, r.rg_ox[k] ?? 0.0, r.rg_oy[k] ?? 0.0);   // offset in parent's frame
      bx += [(bx[p] ?? 0.0) + rx];
      by += [(by[p] ?? 0.0) + ry];
      th += [pth + v];                                                 // revolute joints add in 2D
    }
  }
  x0 = bx[i] ?? 0.0;
  y0 = by[i] ?? 0.0;
  (ex, ey) = pose_of(th[i] ?? 0.0, r.rg_len[i] ?? 0.0, 0.0);           // tip = base + len along angle
  (x0, y0, x0 + ex, y0 + ey)
}

// ── FORWARD KINEMATICS IN SPACE (`G1b`) ──────────────────────────────────────
//
// The world segment of bone `i` IN THREE DIMENSIONS: `(x0,y0,z0)` its base,
// `(x1,y1,z1)` its tip.  The 2-D sibling above is not replaced and not
// re-expressed — see the header for what that would have cost.
//
// The composition is the same tree walk one dimension up: a bone's offset rides
// its PARENT's rotation (not its own joint), and its length runs along its own
// `+x` under its OWN rotation.  What changes is that a rotation can no longer
// be carried as an angle, because two rotations about different axes do not add
// — so a 3x3 basis is carried instead, and Rodrigues builds each joint's own.
//
// ⚠ Nine parallel float vectors is the honest cost of a rig with NO
// DEPENDENCIES.  `mesh3d` owns a `Mat4` and is one `use` away, and taking it
// would make the body model depend on a renderer's linear algebra — which the
// manifest's own note refuses (*"the body is pure continuous-space kinematics
// … with NO lattice dependency"*), and a matrix library is the same kind of
// coupling one step further out.
//
// ⚠ A ZERO-LENGTH AXIS POSES AS THE IDENTITY — the joint simply does not turn,
// which is the honest reading of *"nothing to turn about"*.  It is not repaired
// to `+z`: that would invent an axis the author did not write, and
// `rig_admissible` refuses the rig anyway.
// A bone's WORLD FRAME: where its joint sits, and how its own axes lie.
//
// ⚠ **This is the thing `rig_world_seg3` used to compute and throw away**,
// and a consumer that draws a body needs it: a limb hung on a bone is a
// cloud of points in the BONE's frame, and posing them means applying this
// once and reusing it, not walking the tree per point.
pub struct Frame {
  fr_x: float, fr_y: float, fr_z: float,      // the bone's joint, in world
  fr_00: float, fr_01: float, fr_02: float,   // its basis, row-major
  fr_10: float, fr_11: float, fr_12: float,
  fr_20: float, fr_21: float, fr_22: float,
}

// The world frame of bone `i` at the given joint values.  ⚠ One tree walk;
// pose as many points through it as you like with `frame_point`.
pub fn rig_world_frame3(r: Rig, values: vector<float>, i: integer) -> Frame {
  n = i + 1;
  bx: vector<float> = []; by: vector<float> = []; bz: vector<float> = [];
  m00: vector<float> = []; m01: vector<float> = []; m02: vector<float> = [];
  m10: vector<float> = []; m11: vector<float> = []; m12: vector<float> = [];
  m20: vector<float> = []; m21: vector<float> = []; m22: vector<float> = [];
  for k in 0..n {
    th = (values[k] ?? 0.0) * TAU;
    c = cos(th);
    s = sin(th);
    // The axis is stored AS GIVEN, so it is normalised here — at use, by the
    // one consumer that needs a unit vector.  ⚠ `(0,0,1)` has length exactly
    // 1.0 and the divide is exact, which is what keeps a planar single bone
    // bit-identical to `rig_world_seg`.
    ax = r.rg_ax[k] ?? 0.0; ay = r.rg_ay[k] ?? 0.0; az = r.rg_az[k] ?? 0.0;
    al = sqrt(ax * ax + ay * ay + az * az) ?? 0.0;
    ux = 0.0; uy = 0.0; uz = 0.0;
    if al > 0.0 { ux = ax / al ?? 0.0; uy = ay / al ?? 0.0; uz = az / al ?? 0.0; }
    else { c = 1.0; s = 0.0; }                    // no axis: the identity, never a repair
    omc = 1.0 - c;
    l00 = c + omc * ux * ux;       l01 = omc * ux * uy - s * uz;  l02 = omc * ux * uz + s * uy;
    l10 = omc * uy * ux + s * uz;  l11 = c + omc * uy * uy;       l12 = omc * uy * uz - s * ux;
    l20 = omc * uz * ux - s * uy;  l21 = omc * uz * uy + s * ux;  l22 = c + omc * uz * uz;
    p = r.rg_parent[k] ?? -1;
    if p < 0 {
      bx += [0.0]; by += [0.0]; bz += [0.0];
      m00 += [l00]; m01 += [l01]; m02 += [l02];
      m10 += [l10]; m11 += [l11]; m12 += [l12];
      m20 += [l20]; m21 += [l21]; m22 += [l22];
    } else {
      p00 = m00[p] ?? 1.0; p01 = m01[p] ?? 0.0; p02 = m02[p] ?? 0.0;
      p10 = m10[p] ?? 0.0; p11 = m11[p] ?? 1.0; p12 = m12[p] ?? 0.0;
      p20 = m20[p] ?? 0.0; p21 = m21[p] ?? 0.0; p22 = m22[p] ?? 1.0;
      gx = r.rg_ox[k] ?? 0.0; gy = r.rg_oy[k] ?? 0.0; gz = r.rg_oz[k] ?? 0.0;
      bx += [(bx[p] ?? 0.0) + p00 * gx + p01 * gy + p02 * gz];
      by += [(by[p] ?? 0.0) + p10 * gx + p11 * gy + p12 * gz];
      bz += [(bz[p] ?? 0.0) + p20 * gx + p21 * gy + p22 * gz];
      m00 += [p00 * l00 + p01 * l10 + p02 * l20];
      m01 += [p00 * l01 + p01 * l11 + p02 * l21];
      m02 += [p00 * l02 + p01 * l12 + p02 * l22];
      m10 += [p10 * l00 + p11 * l10 + p12 * l20];
      m11 += [p10 * l01 + p11 * l11 + p12 * l21];
      m12 += [p10 * l02 + p11 * l12 + p12 * l22];
      m20 += [p20 * l00 + p21 * l10 + p22 * l20];
      m21 += [p20 * l01 + p21 * l11 + p22 * l21];
      m22 += [p20 * l02 + p21 * l12 + p22 * l22];
    }
  }
  Frame { fr_x: bx[i] ?? 0.0, fr_y: by[i] ?? 0.0, fr_z: bz[i] ?? 0.0,
          fr_00: m00[i] ?? 1.0, fr_01: m01[i] ?? 0.0, fr_02: m02[i] ?? 0.0,
          fr_10: m10[i] ?? 0.0, fr_11: m11[i] ?? 1.0, fr_12: m12[i] ?? 0.0,
          fr_20: m20[i] ?? 0.0, fr_21: m21[i] ?? 0.0, fr_22: m22[i] ?? 1.0 }
}

// Where a point in the bone's LOCAL frame lands in the world.
pub fn frame_point(f: Frame, lx: float, ly: float, lz: float) -> (float, float, float) {
  (f.fr_x + f.fr_00 * lx + f.fr_01 * ly + f.fr_02 * lz,
   f.fr_y + f.fr_10 * lx + f.fr_11 * ly + f.fr_12 * lz,
   f.fr_z + f.fr_20 * lx + f.fr_21 * ly + f.fr_22 * lz)
}

// The one-shot door: pose ONE point of bone `i`.  ⚠ It walks the tree, so
// a caller posing many points should hold a `Frame` instead.
pub fn rig_world_point3(r: Rig, values: vector<float>, i: integer,
                        lx: float, ly: float, lz: float) -> (float, float, float) {
  frame_point(rig_world_frame3(r, values, i), lx, ly, lz)
}

// ── FORWARD KINEMATICS IN SPACE (`G1b`) ──────────────────────────────────────
//
// The world segment of bone `i` IN THREE DIMENSIONS: `(x0,y0,z0)` its base,
// `(x1,y1,z1)` its tip.  The 2-D sibling above is not replaced and not
// re-expressed — see the header for what that would have cost.
//
// ⚠ Since 0.3.0 this is TWO POINTS of the bone's own frame and nothing more:
// its base is the frame's origin and its tip is `(len, 0, 0)` in it.  One
// implementation of the walk, and the numbers are unchanged — adding a
// rotated `(0,0,0)` is an exact `+ 0.0`.
pub fn rig_world_seg3(r: Rig, values: vector<float>, i: integer)
    -> (float, float, float, float, float, float) {
  f = rig_world_frame3(r, values, i);
  (bx, by, bz) = frame_point(f, 0.0, 0.0, 0.0);
  (tx, ty, tz) = frame_point(f, r.rg_len[i] ?? 0.0, 0.0, 0.0);
  (bx, by, bz, tx, ty, tz)
}

// An oriented bounding box: centre, unit axis (along the bone), and half-extents.
pub struct Obb {
  ob_cx: float, ob_cy: float,   // centre
  ob_ux: float, ob_uy: float,   // unit axis, along the segment
  ob_hl: float,                 // half-length, along the axis
  ob_hw: float,                 // half-width, perpendicular
}

// THE PROXY of bone `i`: the OBB that bounds its capsule of half-width `w`.  Length grows by `w`
// at each end to cover the rounded caps; width is `w`.
pub fn bone_obb(r: Rig, values: vector<float>, i: integer, w: float) -> Obb {
  (x0, y0, x1, y1) = rig_world_seg(r, values, i);
  dx = x1 - x0;
  dy = y1 - y0;
  seg = sqrt(dx * dx + dy * dy) ?? 0.0;
  ux = 1.0;
  uy = 0.0;
  if seg > 0.000000001 { ux = dx / seg ?? 1.0; uy = dy / seg ?? 0.0; }
  Obb { ob_cx: (x0 + x1) / 2.0, ob_cy: (y0 + y1) / 2.0,
        ob_ux: ux, ob_uy: uy, ob_hl: seg / 2.0 + w, ob_hw: w }
}

// Is a world point inside the OBB?  Project onto the axis and its perpendicular.
pub fn obb_contains(o: Obb, px: float, py: float) -> boolean {
  dx = px - o.ob_cx;
  dy = py - o.ob_cy;
  along = dx * o.ob_ux + dy * o.ob_uy;
  perp = 0.0 - dx * o.ob_uy + dy * o.ob_ux;
  fabs(along) <= o.ob_hl && fabs(perp) <= o.ob_hw
}

// Distance from a point to a segment — the capsule test's core.
pub fn seg_dist(x0: float, y0: float, x1: float, y1: float, px: float, py: float) -> float {
  dx = x1 - x0;
  dy = y1 - y0;
  l2 = dx * dx + dy * dy;
  if l2 < 0.000000000001 { return sqrt((px - x0) * (px - x0) + (py - y0) * (py - y0)) ?? 0.0; }
  t = ((px - x0) * dx + (py - y0) * dy) / l2 ?? 0.0;
  if t < 0.0 { t = 0.0; }
  if t > 1.0 { t = 1.0; }
  cx = x0 + t * dx;
  cy = y0 + t * dy;
  sqrt((px - cx) * (px - cx) + (py - cy) * (py - cy)) ?? 0.0
}

// The bone's SHAPE: is a world point within `w` of its segment (inside the capsule)?
pub fn bone_shape_has(r: Rig, values: vector<float>, i: integer, w: float,
                      px: float, py: float) -> boolean {
  (x0, y0, x1, y1) = rig_world_seg(r, values, i);
  seg_dist(x0, y0, x1, y1, px, py) <= w
}
