// hex_fit — the conformance tests: the doorstep refuses at authoring time what would not
// round-trip, with a named reason, an offer, and a residual.
//
// Contract only; the exhaustive measurement is hexbody's `tests/fit.loft`.
use hex_fit;
use hex_field;


fn main() {
  // a valid arc shell is admitted, an off-shell radius is refused -- the doorstep DISTINGUISHES.
  assert(arc_fits(36) == FIT_OK, "shell 36 is admitted");
  assert(arc_fits(37) != FIT_OK, "off-shell 37 is refused");
}

fn test_a_refusal_names_its_reason() {
  code = arc_fits(37);
  reason = fit_reason(code);
  assert(reason.len() > 0, "a refusal carries a named reason, not a blank no");
}

fn test_an_off_shell_radius_offers_the_nearest_that_fits() {
  // K-FIT: a refusal offers the nearest admissible alternative. For an ORDINAL parameter (a
  // radius) an offer is owed -- unlike a material id, which is nominal (X68).
  n = arc_fit_n(37);
  assert(arc_is_shell(n), "the offered radius is itself a shell, got {n}");
  res = arc_fit_residual(37);
  assert(res >= 0, "and the residual is reported, got {res}");
}

fn test_a_level_has_nothing_to_refuse_and_that_is_the_result() {
  // A level is an integer index -- nothing exists between two levels to snap to -- so the
  // doorstep accepts every level. A doorstep that refused more than the field distinguishes
  // would make legal models unauthorable (X66).
  assert(level_fits(0) == FIT_OK, "level 0 fits");
  assert(level_fits(1000000) == FIT_OK, "and so does level 1e6 -- levels are identical at any n");
}

fn test_the_height_slot_is_an_integer_grid() {
  // moros's h_height is an integer at HEIGHT_SCALE wu (X67). A height off that grid truncates
  // silently, so the doorstep refuses it -- and an on-grid height round-trips.
  u = height_units(height_from_units(3));
  assert(u == 3, "an on-grid height round-trips through the voxel, got {u}");
}

fn test_the_height_quantum_is_the_callers() {
  // ⛔ THE CONSTANT CANNOT SERVE A DOORSTEP. A world carries its own height unit, and a
  // consumer measured this package giving the WRONG VERDICT on 40 of 81 sampled heights at
  // 0.125 and 30 of 81 at 1.0 (moros probe/b7). X66 says a doorstep wrong about the grid is
  // worse than none -- the case it did not cover is testing against a grid the field lacks.
  //
  // A HALF-UNIT AT ONE QUANTUM IS A WHOLE UNIT AT ANOTHER, which is the whole of it.
  assert(seat_fits_at(0.125, 0.25) == FIT_BAD_HEIGHT, "0.125 is half a unit at 0.25");
  assert(seat_fits_at(0.125, 0.125) == FIT_OK, "...and a whole one at 0.125");
  assert(seat_fits_at(0.5, 1.0) == FIT_BAD_HEIGHT, "0.5 is half a unit at 1.0");
  assert(seat_fits_at(2.0, 1.0) == FIT_OK, "...and 2.0 is two whole ones");

  // The offer and the residual follow the quantum they were given.
  assert(seat_fit_z_at(0.3, 0.125) == 0.25, "the offer at 0.125 is 0.25, got {seat_fit_z_at(0.3, 0.125)}");
  assert(seat_fit_z_at(0.3, 1.0) == 0.0, "...and at 1.0 it is 0.0, got {seat_fit_z_at(0.3, 1.0)}");
  assert(abs(seat_fit_residual_at(0.3, 1.0) - 0.3) < 1e-12, "with the residual to match");

  // The default is unchanged for every existing caller -- the wrappers ARE the old behaviour.
  assert(seat_fits(0.3) == seat_fits_at(0.3, HEIGHT_SCALE), "the wrapper is the _at form at 0.25");
  assert(seat_fit_z(0.3) == seat_fit_z_at(0.3, HEIGHT_SCALE), "and so is the offer");
  assert(height_units(0.75) == height_units_at(0.75, HEIGHT_SCALE), "and the unit count");
}

fn test_a_quantum_that_is_not_a_grid_is_refused_by_name() {
  // ⚠ loft's division by zero yields null and keeps running, so an unchecked `z / scale`
  // discharges to 0.0 -- and the doorstep would answer "on the grid" for 0 and "off it" for
  // everything else. A wrong verdict dressed as a real one is what a doorstep exists not to
  // produce, so a non-positive quantum has its own code.
  assert(seat_fits_at(1.0, 0.0) == FIT_BAD_SCALE, "a zero quantum is not a grid");
  assert(seat_fits_at(0.0, 0.0) == FIT_BAD_SCALE, "...and zero height does not excuse it");
  assert(seat_fits_at(1.0, 0.0 - 0.25) == FIT_BAD_SCALE, "nor does a negative one");
  assert(fit_reason(FIT_BAD_SCALE) != "", "and the refusal carries a reason");
  assert(fit_reason(FIT_BAD_SCALE) != fit_reason(FIT_BAD_HEIGHT),
         "...which is not the height reason wearing a different code");
}
