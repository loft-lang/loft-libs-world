// hex_draw — the conformance tests: a Plan draws into the field, and its wall surface reads back.
//
// Contract only; the exhaustive measurement is hexbody's `tests/house.loft` and `tests/surface.loft`.
use hex_draw::*;
use hex_form::*;
use hex_field::*;

fn plan5x4() -> Plan { plan_new(0, 0, 5, 4, 0, false) }

// How far two positions may lie apart and be the same: a thousand millionth where a `float` is
// a double, a hundred thousandth where it is a single (a 32-bit program), which holds about
// seven digits — the boxes here reach ten units from the origin, and a hex edge is one.
fn same_place() -> float {
  if 1.0 + 0.000000000001 > 1.0 { 0.000000001 } else { 0.00001 }
}

fn main() {
  p = plan5x4();
  cells = hexset_chunk(-20, -20, 41, 41);
  types = labels_new(-20, -20, 41, 41);
  n = draw_floor(p, cells, types, 1);
  assert(n == 27, "a 5x4 house has 27 floor cells, got {n}");
}

fn test_the_walls_are_one_connected_boundary() {
  p = plan5x4();
  cells = hexset_chunk(-20, -20, 41, 41);
  types = labels_new(-20, -20, 41, 41);
  edges = edgeset_new(-20, -20, 41, 41);
  draw_floor(p, cells, types, 1);
  ne = draw_walls(cells, edges, 7);
  assert(ne == 38, "the 5x4 house has 38 wall edges, got {ne}");
}

// A consumer reads a surface's exact rational and builds one as a control (hexbody's surface
// gate): every field of `WallSurface` is readable and buildable outside this library.
fn test_a_surface_is_its_exact_rational() {
  p = plan5x4();
  cells = hexset_chunk(-20, -20, 41, 41);
  types = labels_new(-20, -20, 41, 41);
  draw_floor(p, cells, types, 1);
  w = surface_of(p, cells, 0);
  assert(w.ws_n > 0 && w.ws_den == 2 * w.ws_n, "den is twice the edges averaged: {w.ws_den} vs {w.ws_n}");
  one = WallSurface { ws_dk: 2, ws_dm: 0, ws_num_k: 4, ws_num_m: 0, ws_den: 2, ws_n: 1 };
  assert(surface_mean_x(one) > 1.73 && surface_mean_x(one) < 1.74, "mean x of (4/2) is 2 * 0.866, got {surface_mean_x(one)}");
}

fn test_a_wall_recovers_as_one_exact_surface() {
  // `G2`: a wall is not a strip of edges, it is one analytic surface -- and its direction is
  // EXACTLY a heading, not a fitted approximation.  This is what a game emits as a collision proxy.
  p = plan5x4();
  cells = hexset_chunk(-20, -20, 41, 41);
  types = labels_new(-20, -20, 41, 41);
  draw_floor(p, cells, types, 1);
  w = surface_of(p, cells, 0);
  assert(surface_is_exact(w), "side 0's surface is exact");
  spread = surface_fitted_spread(p, cells, 0);
  // Exactly 0 at this orientation, and that is luck: the derivation is exact but the span is
  // presented in floats, so 16 of the 12 orientations x 4 sides read one ulp instead (the
  // worked examples measure the census).  What holds everywhere is flat against the STRIP's
  // own width, which is fifteen orders of magnitude larger.
  assert(spread < BAND_TOPS * 1e-14,
         "the fitted surface is flat where the strip it replaces is {BAND_TOPS} wide, got {spread}");
}

// `surface_meet` is the miter of any two surfaces; on two sides of a `Plan` it is `surface_miter`,
// to the bit, at all 12 orientations.  And `surface_dir` is a unit vector along the heading.
fn test_surface_meet_is_the_miter_of_two_surfaces() {
  for rot in 0..6 {
    for mir in 0..2 {
      p = plan_new(0, 0, 5, 4, rot, mir == 1);
      cells = hexset_chunk(-20, -20, 41, 41);
      types = labels_new(-20, -20, 41, 41);
      draw_floor(p, cells, types, 1);
      for side in 0..4 {
        nx = if side == 3 { 0 } else { side + 1 };
        (mx, my, mok) = surface_miter(p, cells, side, nx);
        (x, y, ok) = surface_meet(surface_of(p, cells, side), surface_of(p, cells, nx));
        assert(ok && mok && x == mx && y == my, "rot {rot} mir {mir} side {side}: the meet is the miter");
        w = surface_of(p, cells, side);
        (dx, dy) = surface_dir(w);
        ln = dx * dx + dy * dy;
        assert(ln > 1.0 - same_place() && ln < 1.0 + same_place(), "rot {rot} side {side}: a unit direction, {ln}");
        st = head_step(surface_heading(w));
        assert(dx * (st.1 as float) * 0.5 - dy * (st.0 as float) * 0.8660254037844386 < same_place()
               && dx * (st.1 as float) * 0.5 - dy * (st.0 as float) * 0.8660254037844386 > -same_place(),
               "rot {rot} side {side}: along its heading");
      }
      (_x, _y, par) = surface_meet(surface_of(p, cells, 0), surface_of(p, cells, 2));
      assert(!par, "rot {rot} mir {mir}: opposite sides do not meet");
    }
  }
  // Parallel is a question of the two directions, whatever the walls' lengths: one step along
  // each heading against three steps back along it, on another line.  (Asked of rounded
  // products, 3 944 of 18 252 such pairs met where a `float` is a single.)
  for h in 0..12 {
    st = head_step(h);
    a = WallSurface { ws_dk: st.0, ws_dm: st.1, ws_num_k: 4, ws_num_m: 2, ws_den: 2, ws_n: 1 };
    b = WallSurface { ws_dk: -3 * st.0, ws_dm: -3 * st.1, ws_num_k: 40, ws_num_m: -22, ws_den: 2, ws_n: 1 };
    (_px, _py, meets) = surface_meet(a, b);
    assert(!meets, "heading {h}: two parallel walls of different lengths do not meet");
  }
}

// ── cellwalls: straight walls from the cells alone ──────────────────────────

fn box_cells(rot: integer, mir: boolean) -> HexSet {
  cells = hexset_chunk(-20, -20, 41, 41);
  types = labels_new(-20, -20, 41, 41);
  draw_floor(plan_new(0, 0, 5, 4, rot, mir), cells, types, 1);
  cells
}

// How far the point (px, py) lies to the left of surface `w`'s line, in world units.
fn left_of(w: WallSurface, px: float, py: float) -> float {
  (dx, dy) = surface_dir(w);
  (px - surface_mean_x(w)) * (0.0 - dy) + (py - surface_mean_y(w)) * dx
}

// A box known only by its cells, at all 12 orientations: four walls, each exactly along a
// heading, each square to the next, every boundary edge in one run, each corner on both its
// walls — and every cell centre clearly inside all four or outside one (@FR-HW-Clear).
fn test_a_box_from_its_cells_has_four_square_walls() {
  for rot in 0..6 {
    for mir in 0..2 {
      cells = box_cells(rot, mir == 1);
      b = cells_built(cells, 9);
      assert(len(b.cw_walls) == 4 && len(b.cw_corners) == 4 && len(b.cw_kinds) == 4, "rot {rot} mir {mir}: four walls, got {len(b.cw_walls)}");
      assert(len(b.cw_boundary) == 38, "rot {rot}: the 38 edges draw_walls marks, got {len(b.cw_boundary)}");
      inrun = 0;
      for run in b.cw_runs { inrun += len(run); }
      assert(inrun == 38, "rot {rot}: every edge in one run");
      for i in 0..4 {
        w = b.cw_walls[i]!;
        nx = b.cw_walls[(i + 1) % 4 ?? 0]!;
        assert(surface_heading(w) >= 0, "rot {rot} wall {i}: along a heading");
        assert(head_norm(surface_heading(nx) - surface_heading(w)) == 3, "rot {rot} wall {i}: the next a quarter turn on");
        assert(vec_dot_4(w.ws_dk, w.ws_dm, nx.ws_dk, nx.ws_dm) == 0, "rot {rot} wall {i}: square to the next, exactly");
        c = b.cw_corners[i] ?? (0.0, 0.0);
        assert(abs(left_of(w, c.0, c.1)) < same_place() && abs(left_of(nx, c.0, c.1)) < same_place(), "rot {rot} corner {i}: on both its walls");
        assert(b.cw_kinds[i] == WALL_STRAIGHT, "rot {rot} wall {i}: straight");
      }
      for r in -20..21 {
        for q in -20..21 {
          least = 1000.0;
          for w in b.cw_walls {
            d = left_of(w, cell_x(q, r), cell_y(q, r));
            if d < least { least = d; }
          }
          if hexset_get(cells, q, r) {
            assert(least > 0.2, "rot {rot}: cell {q},{r} of the box lies clearly inside its walls ({least})");
          } else {
            assert(least < -0.2, "rot {rot}: cell {q},{r} outside lies clearly outside a wall ({least})");
          }
        }
      }
    }
  }
}

// Against `surface_of`, which is told the `Plan`: a TOPS wall (an even heading) is the same line,
// exactly — the two rationals name one point across it.  A SIDES wall (an odd heading) is not:
// `surface_of` averages every edge its side holds, the corner's with them, where `cells_wall`
// reads the line off the slanted connectors and outvotes the corner's.  On the 5 x 4 box they
// lie 0.0481 world units (4 cm) apart.  Both are exact; they answer two questions.
fn test_a_wall_from_cells_against_the_plans_surface() {
  for rot in 0..6 {
    p = plan_new(0, 0, 5, 4, rot, false);
    cells = box_cells(rot, false);
    b = cells_built(cells, 9);
    tops = 0;
    sides = 0;
    for side in 0..4 {
      s = surface_of(p, cells, side);
      for w in b.cw_walls {
        if surface_heading(w) != surface_heading(s) { continue; }
        // the offset of s's mean from w's line, x 4 x both denominators x |w's step|: exact
        ek = s.ws_num_k * w.ws_den - w.ws_num_k * s.ws_den;
        em = s.ws_num_m * w.ws_den - w.ws_num_m * s.ws_den;
        cross = 3 * ek * perp_k(w.ws_dk, w.ws_dm) + em * perp_m(w.ws_dk, w.ws_dm);
        if head_is_edge(surface_heading(w)) {
          assert(cross == 0, "rot {rot} side {side}: a tops wall is surface_of's line");
          tops += 1;
        } else {
          off = abs(left_of(w, surface_mean_x(s), surface_mean_y(s)));
          assert(cross != 0 && off > 0.0481 && off < 0.0482, "rot {rot} side {side}: a sides wall lies 0.0481 beside surface_of's ({off})");
          sides += 1;
        }
      }
    }
    assert(tops == 2 && sides == 2, "rot {rot}: two walls of each kind, got {tops} and {sides}");
  }
}

// Is `p` (a coordinate along heading `head`, scaled) between the lines `lo` and `hi` half steps out?
fn between(head: integer, p: integer, lo: integer, hi: integer) -> boolean {
  if head_is_edge(head) { return p >= 12 * lo && p <= 12 * hi; }
  sign_root3(p, -12 * lo) >= 0 && sign_root3(p, -12 * hi) <= 0
}

// An L along heading `h`, by exact tests: a body 5 hex steps by 3, a wing 2 by 2 on one end of
// its far side (in half steps: u -5 .. 5, v -3 .. 3 and u -5 .. -1, v 3 .. 7).
fn ell_cells(h: integer) -> HexSet {
  cells = hexset_chunk(-20, -20, 41, 41);
  us = head_step(h);
  vs = head_step(h + 3);
  for r in -20..21 {
    for q in -20..21 {
      u = vec_dot_4(2 * lattice_k(q, r), 2 * lattice_m(q, r), us.0, us.1);
      v = vec_dot_4(2 * lattice_k(q, r), 2 * lattice_m(q, r), vs.0, vs.1);
      body = between(h, u, -5, 5) && between(h + 3, v, -3, 3);
      wing = between(h, u, -5, -1) && between(h + 3, v, 3, 7);
      if body || wing { hexset_set(cells, q, r, true); }
    }
  }
  cells
}

// An L (two rectangles): six walls, five corners turning left and one right, all square; seven
// cells (a hex and its neighbours) show no direction, so the axes are the caller's hint
// (@FR-HX-Size); and `cells_boundary` is `cells_loops`' first loop, closed.
fn test_an_ell_and_a_structure_too_small() {
  for rot in 0..6 {
    cells = ell_cells(2 * rot);
    b = cells_built(cells, 9);
    assert(len(b.cw_walls) == 6, "rot {rot}: an L has six walls, got {len(b.cw_walls)}");
    left = 0;
    right = 0;
    for i in 0..6 {
      w = b.cw_walls[i]!;
      nx = b.cw_walls[(i + 1) % 6 ?? 0]!;
      assert(vec_dot_4(w.ws_dk, w.ws_dm, nx.ws_dk, nx.ws_dm) == 0, "rot {rot} wall {i}: square to the next");
      if w.ws_dk * nx.ws_dm - w.ws_dm * nx.ws_dk > 0 { left += 1; } else { right += 1; }
    }
    assert(left == 5 && right == 1, "rot {rot}: five corners turn left, one right: {left} and {right}");
    bd = cells_boundary(cells);
    n = len(bd);
    for i in 0..n {
      e = bd[i]!;
      f = bd[(i + 1) % n ?? 0]!;
      assert(e.we_bk == f.we_ak && e.we_bm == f.we_am, "rot {rot}: edge {i} ends where the next begins");
    }
  }
  seven = hexset_chunk(-4, -4, 9, 9);
  hexdisk_into(seven, 0, 0, 1);
  assert(cells_axes(cells_boundary(seven)) == -1, "a hex and its six neighbours show no direction");
}

// Any number of loops: a hall round a court is two outlines of four walls, the court's walked
// the other way round (its cells still on its left); every corner of both square.
fn test_outlines_of_a_hall_round_a_court() {
  cells = hexset_chunk(-24, -24, 49, 49);
  types = labels_new(-24, -24, 49, 49);
  draw_floor(plan_new(0, 0, 12, 10, 0, false), cells, types, 1);
  court = hexset_chunk(-24, -24, 49, 49);
  draw_floor(plan_new(0, 0, 5, 4, 0, false), court, types, 1);
  for r in -24..25 { for q in -24..25 { if hexset_get(court, q, r) { hexset_set(cells, q, r, false); } } }
  os = cells_outlines(cells, 0);
  assert(len(os) == 2, "a hall round a court: two loops, got {len(os)}");
  turns: vector<integer> = [];
  for o in os {
    n = len(o.co_walls);
    assert(n == 4 && len(o.co_corners) == 4, "four walls a loop, got {n}");
    left = 0;
    for i in 0..n {
      w = o.co_walls[i]!;
      nx = o.co_walls[(i + 1) % n ?? 0]!;
      assert(vec_dot_4(w.ws_dk, w.ws_dm, nx.ws_dk, nx.ws_dm) == 0, "wall {i}: square to the next");
      if w.ws_dk * nx.ws_dm - w.ws_dm * nx.ws_dk > 0 { left += 1; }
    }
    turns += [left];
  }
  assert(turns == [4, 0], "the hall's loop turns left four times, the court's right: {turns}");
}

// ── cellopen: doors and windows on walls from cells ─────────────────────────

// An opening placed at a point marks edges of the nearest wall, reads back as one opening on
// that wall with its centre on the wall's line and a span of its kind's width, clear of both
// corners — on every wall of a box at all 12 orientations, and of two widths.  The walls are
// built once for all of them; the marks never change the walls (@FR-HO-Point, HO-Place, HO-Clear).
fn test_an_opening_at_a_point_reads_back_on_its_wall() {
  for rot in 0..6 {
    for wide in 0..2 {
      cells = box_cells(rot, false);
      cw = cells_built(cells, 9);
      sz = opening_sizes(1.0 + (wide as float) * 1.2, 1.0, 0.8660254037844386);
      marks = cells_no_marks(cells);
      for i in 0..4 {
        // a point a third of the way along wall i, a little outside it
        a = cw.cw_corners[(i + 3) % 4 ?? 0] ?? (0.0, 0.0);
        b = cw.cw_corners[i] ?? (0.0, 0.0);
        (dx, dy) = surface_dir(cw.cw_walls[i]!);
        px = a.0 + (b.0 - a.0) / 3.0 + dy * 0.3;
        py = a.1 + (b.1 - a.1) / 3.0 - dx * 0.3;
        kind = if i % 2 == 0 { OPEN_DOOR } else { OPEN_WINDOW };
        assert(cells_place_opening(cw, marks, kind, px, py, sz), "rot {rot} wall {i}: placed");
      }
      ops = cells_openings(cw.cw_boundary, cw.cw_runs, cw.cw_walls, marks, sz);
      assert(len(ops) == 4, "rot {rot} width {wide}: four openings read back, got {len(ops)}");
      // An edge exactly half the opening's width from its centre is the opening's: turned 60
      // degrees, the door one unit wide takes two edges and the window one.
      if rot == 1 && wide == 0 {
        taken = "";
        for o in ops { taken += "{len(o.op_edges)}"; }
        assert(taken == "2121", "rot 1: a door of two edges, a window of one, got {taken}");
      }
      for o in ops {
        i = o.op_wall;
        w = cw.cw_walls[i]!;
        assert(o.op_kind == (if i % 2 == 0 { OPEN_DOOR } else { OPEN_WINDOW }), "rot {rot} wall {i}: its kind");
        assert(abs(left_of(w, o.op_cx, o.op_cy)) < same_place(), "rot {rot} wall {i}: its centre on the wall's line");
        span = sqrt((o.op_bx - o.op_ax) * (o.op_bx - o.op_ax) + (o.op_by - o.op_ay) * (o.op_by - o.op_ay)) ?? 0.0;
        assert(abs(span - opening_size(o.op_kind, sz)) < same_place(), "rot {rot} wall {i}: its kind's width, {span}");
        a = cw.cw_corners[(i + 3) % 4 ?? 0] ?? (0.0, 0.0);
        b = cw.cw_corners[i] ?? (0.0, 0.0);
        (dx, dy) = surface_dir(w);
        from_a = (o.op_ax - a.0) * dx + (o.op_ay - a.1) * dy;
        to_b = (b.0 - o.op_bx) * dx + (b.1 - o.op_by) * dy;
        assert(from_a > 0.0 && to_b > 0.0, "rot {rot} wall {i}: between its wall's corners ({from_a}, {to_b})");
        assert(len(o.op_edges) >= 1, "rot {rot} wall {i}: on an edge at least");
        for ei in o.op_edges {
          e = cw.cw_boundary[ei]!;
          assert(edge_mat(marks, e.we_qa, e.we_ra, e.we_qb, e.we_rb) == o.op_kind, "rot {rot} wall {i}: its edges marked");
        }
      }
      again = cells_built(cells, 9);
      for i in 0..4 {
        assert(again.cw_walls[i]!.ws_num_k == cw.cw_walls[i]!.ws_num_k && again.cw_walls[i]!.ws_num_m == cw.cw_walls[i]!.ws_num_m,
               "rot {rot}: the walls are the cells', whatever is marked");
      }
    }
  }
}

// At size: a ward of 80 by 64 hex steps (5 877 cells, 614 boundary edges) is still four walls,
// square, every edge in a run, its two long walls 158 edges and its two short ones 149; and a
// ragged street 396 cells long, stepping over by a row every nine cells, is one outline whose
// every corner is square — a step between each two stretches (@FR-HW-Step).
fn test_walls_from_cells_at_size() {
  cells = hexset_chunk(-150, -150, 301, 301);
  us = head_step(0);
  vs = head_step(3);
  for r in -150..151 {
    for q in -150..151 {
      u = vec_dot_4(2 * lattice_k(q, r), 2 * lattice_m(q, r), us.0, us.1);
      v = vec_dot_4(2 * lattice_k(q, r), 2 * lattice_m(q, r), vs.0, vs.1);
      if between(0, u, -80, 80) && between(3, v, -64, 64) { hexset_set(cells, q, r, true); }
    }
  }
  assert(hexset_count(cells) == 5877, "the ward's cells: {hexset_count(cells)}");
  b = cells_built(cells, 9);
  assert(len(b.cw_boundary) == 614 && len(b.cw_walls) == 4, "614 edges, four walls: {len(b.cw_boundary)} and {len(b.cw_walls)}");
  sizes: vector<integer> = [];
  for i in 0..4 {
    w = b.cw_walls[i]!;
    nx = b.cw_walls[(i + 1) % 4 ?? 0]!;
    assert(vec_dot_4(w.ws_dk, w.ws_dm, nx.ws_dk, nx.ws_dm) == 0, "ward wall {i}: square to the next");
    sizes += [len(b.cw_runs[i]!)];
  }
  sizes.sort();
  assert(sizes[0]! + sizes[1]! + sizes[2]! + sizes[3]! == 614 && sizes[0]! > 100, "every edge in a long run: {sizes}");

  street = hexset_chunk(-210, -30, 421, 61);
  // whole stretches of nine cells: a stub of two at an end would be a slanted wall of its own
  // (@FR-HW-Slant), which is right and not square
  for q in -198..198 {
    off = ((q + 207) / 9 ?? 0) % 3 ?? 0;
    for r in off - 1..off + 2 { hexset_set(street, q, r, true); }
  }
  os = cells_outlines(street, 0);
  assert(len(os) == 1, "a street is one outline, got {len(os)}");
  n = len(os[0]!.co_walls);
  assert(n >= 100 && len(os[0]!.co_corners) == n, "a wall a stretch and a step between: {n}");
  for i in 0..n {
    w = os[0]!.co_walls[i]!;
    nx = os[0]!.co_walls[(i + 1) % n ?? 0]!;
    assert(vec_dot_4(w.ws_dk, w.ws_dm, nx.ws_dk, nx.ws_dm) == 0, "street wall {i}: square to the next");
  }
}
