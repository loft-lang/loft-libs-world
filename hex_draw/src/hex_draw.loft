// hex_draw — draw a model into the field, and read its surface back.
//
// The `draw` map: a `Plan` becomes floor cells, wall edges, openings and a roof height field.
// And the inverse reading — a wall's ANALYTIC SURFACE recovered as the exact average of its
// stored edges, so a wall renders as one flat quad rather than a strip of them.
//
// Entry point: re-exports `housedraw`, `hexsurf`.
use housedraw;
use hexsurf;
