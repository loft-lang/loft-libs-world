//
// bench — the performance pass: the package's hot doors, timed on a fixed workload, with a
// hash of what they produced.
//
//     loft --interpret bench/bench.loft [--n N]         the interpreter
//     loft --native-release bench/bench.loft [--n N]    compiled
//     rustc -O --edition=2021 bench/bench.rs -o bench/.build/stats_rs   the Rust twin
//
// One tab-separated line per routine: name, iterations, total µs, ns per op, items one op
// processes (window cells times the sides asked), ns per item, and an FNV-1a-32 hash of one
// canonical op's output.  The interpreter, the native build and the pure-Rust twin in
// bench/bench.rs must print the same hash for a row, or one of them is not computing the
// routine it claims to.
//
// Every op starts from the repetition number `r`: `r & 1` moves the plan's anchor by one
// column — the values, never the amount of work — so no backend can hoist an op out of the
// repetition loop.  Each op's result is folded into `sink`.
use hex_field;
use hex_form;
use hex_draw;

/// One measured routine.
struct Row {
  name: text = "",
  iters: integer = 0,
  us: integer = 0,
  px: integer = 0,
  hash: integer = 0,
  sink: integer = 0,
}

const FNV_OFFSET = 2166136261;
const FNV_PRIME = 16777619;

const WIN = 61;
const HALF = 30;
const SIDES = 4;

/// FNV-1a-32 over the low 32 bits of each integer, high byte first.
fn fnv(h0: integer, v: const vector<integer>) -> integer {
  fv_h = h0;
  for x in v {
    fv_w = x & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 24) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 16) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 8) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ (fv_w & 255)) * FNV_PRIME) & 0xFFFFFFFF;
  }
  fv_h
}

fn print_row(r: const Row) {
  pr_ns = ((r.us * 1000) / r.iters) ?? 0;
  pr_px = if r.px > 0 { (((r.us * 1000) as float) / ((r.iters * r.px) as float)) ?? 0.0 }
          else { 0.0 };
  println("{r.name}\t{r.iters}\t{r.us}\t{pr_ns}\t{r.px}\t{pr_px:.3}\t{r.hash:x}");
}

// ── The fitted wall quad: its perpendicular spread, per side ────────

/// A 24 x 20 plan at the second of the six rotations, anchored `dq` columns right.
fn plan_at(dq: integer) -> Plan { plan_new(dq, 0, 24, 20, 1, false) }

/// The plan drawn as floor into a 61 x 61 window.
fn footprint(p: Plan) -> HexSet {
  fp_c = hexset_chunk(0 - HALF, 0 - HALF, WIN, WIN);
  fp_l = labels_new(0 - HALF, 0 - HALF, WIN, WIN);
  draw_floor(p, fp_c, fp_l, 1);
  fp_c
}

/// The spread of all four sides.  The spread is an ulp-scale number (0 or ~2e-16), so each
/// side is hashed at 1e18 as well as at the usual 1e6.
fn spread_op(p: Plan, cells: HexSet) -> vector<integer> {
  so_out: vector<integer> = [];
  for side in 0..SIDES {
    sp = surface_fitted_spread(p, cells, side);
    so_out += [(sp * 1000000.0) as integer, (sp * 1000000000000000000.0) as integer];
  }
  so_out
}

fn bench_spread(n: integer) -> Row {
  bs_p0 = plan_at(0);
  bs_p1 = plan_at(1);
  bs_c0 = footprint(bs_p0);
  bs_c1 = footprint(bs_p1);
  bs_t0 = ticks();
  bs_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bs_sink += spread_op(bs_p0, bs_c0)[1]?; }
    else { bs_sink += spread_op(bs_p1, bs_c1)[1]?; }
  }
  bs_us = ticks() - bs_t0;
  bs_out = spread_op(bs_p0, bs_c0);
  bs_out += [hexset_count(bs_c0), hexset_count(bs_c1)];
  Row { name: "surface_fitted_spread", iters: n, us: bs_us, px: SIDES * WIN * WIN,
        hash: fnv(FNV_OFFSET, bs_out), sink: bs_sink }
}

fn main() {
  mn_n = 20;
  mn_args = arguments();
  mn_i = 0;
  while mn_i < len(mn_args) {
    if mn_args[mn_i]? == "--n" && mn_i + 1 < len(mn_args) {
      mn_n = (mn_args[mn_i + 1]? as integer?)?;
      mn_i += 1;
    }
    mn_i += 1;
  }
  if mn_n < 1 { mn_n = 1; }
  mn_t0 = ticks();
  println("routine\titers\tus\tns_op\tpx\tns_px\thash");
  mn_rows: vector<Row> = [bench_spread(mn_n)];
  mn_sink = 0;
  for row in mn_rows {
    print_row(row);
    mn_sink += row.sink;
  }
  println("time: {(ticks() - mn_t0) / 1000}ms sink={mn_sink}");
}
