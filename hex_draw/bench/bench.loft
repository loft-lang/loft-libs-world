//
// bench — the performance pass: the package's hot doors, timed on a fixed workload, with a
// hash of what they produced.
//
//     loft --interpret bench/bench.loft [--n N]         the interpreter
//     loft --native-release bench/bench.loft [--n N]    compiled
//     rustc -O --edition=2021 bench/bench.rs -o bench/.build/stats_rs   the Rust twin
//
// One tab-separated line per routine: name, iterations, total µs, ns per op, items one op
// processes (window cells times the sides asked), ns per item, and an FNV-1a-32 hash of one
// canonical op's output.  The interpreter, the native build and the pure-Rust twin in
// bench/bench.rs must print the same hash for a row, or one of them is not computing the
// routine it claims to.
//
// Every op starts from the repetition number `r`: `r & 1` moves the plan's anchor by one
// column — the values, never the amount of work — so no backend can hoist an op out of the
// repetition loop.  Each op's result is folded into `sink`.
use hex_field::*;
use hex_form::*;
use hex_draw::*;

/// One measured routine.
struct Row {
  name: text = "",
  iters: integer = 0,
  us: integer = 0,
  px: integer = 0,
  hash: integer = 0,
  sink: integer = 0,
}

const FNV_OFFSET = 2166136261;
const FNV_PRIME = 16777619;

const WIN = 61;
const HALF = 30;
const SIDES = 4;

/// FNV-1a-32 over the low 32 bits of each integer, high byte first.
fn fnv(h0: integer, v: const vector<integer>) -> integer {
  fv_h = h0;
  for x in v {
    fv_w = x & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 24) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 16) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 8) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ (fv_w & 255)) * FNV_PRIME) & 0xFFFFFFFF;
  }
  fv_h
}

fn print_row(r: const Row) {
  pr_ns = ((r.us * 1000) / r.iters) ?? 0;
  pr_px = if r.px > 0 { (((r.us * 1000) as float) / ((r.iters * r.px) as float)) ?? 0.0 }
          else { 0.0 };
  println("{r.name}\t{r.iters}\t{r.us}\t{pr_ns}\t{r.px}\t{pr_px:.3}\t{r.hash:x}");
}

// ── The fitted wall quad: its perpendicular spread, per side ────────

/// A 24 x 20 plan at the second of the six rotations, anchored `dq` columns right.
fn plan_at(dq: integer) -> Plan { plan_new(dq, 0, 24, 20, 1, false) }

/// The plan drawn as floor into a 61 x 61 window.
fn footprint(p: Plan) -> HexSet {
  fp_c = hexset_chunk(0 - HALF, 0 - HALF, WIN, WIN);
  fp_l = labels_new(0 - HALF, 0 - HALF, WIN, WIN);
  draw_floor(p, fp_c, fp_l, 1);
  fp_c
}

/// The spread of all four sides.  The spread is an ulp-scale number (0 or ~2e-16), so each
/// side is hashed at 1e18 as well as at the usual 1e6.
fn spread_op(p: Plan, cells: HexSet) -> vector<integer> {
  so_out: vector<integer> = [];
  for side in 0..SIDES {
    sp = surface_fitted_spread(p, cells, side);
    so_out += [(sp * 1000000.0) as integer, (sp * 1000000000000000000.0) as integer];
  }
  so_out
}

fn bench_spread(n: integer) -> Row {
  bs_p0 = plan_at(0);
  bs_p1 = plan_at(1);
  bs_c0 = footprint(bs_p0);
  bs_c1 = footprint(bs_p1);
  bs_t0 = ticks();
  bs_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bs_sink += spread_op(bs_p0, bs_c0)[1]?; }
    else { bs_sink += spread_op(bs_p1, bs_c1)[1]?; }
  }
  bs_us = ticks() - bs_t0;
  bs_out = spread_op(bs_p0, bs_c0);
  bs_out += [hexset_count(bs_c0), hexset_count(bs_c1)];
  Row { name: "surface_fitted_spread", iters: n, us: bs_us, px: SIDES * WIN * WIN,
        hash: fnv(FNV_OFFSET, bs_out), sink: bs_sink }
}

// ── cellwalls: the walls of a structure from its cells alone ────────

const BUILDS = 20;
const OUTLINES = 10;

/// An L as cells in the 61 x 61 window: a body 20 hex steps by 12 about cell (dq, 0) and a wing
/// 8 by 8 on its far side.
fn ell(dq: integer) -> HexSet {
  el_c = hexset_chunk(0 - HALF, 0 - HALF, WIN, WIN);
  el_l = labels_new(0 - HALF, 0 - HALF, WIN, WIN);
  draw_floor(plan_new(dq, 0, 20, 12, 0, false), el_c, el_l, 1);
  draw_floor(plan_new(dq - 6, 9, 8, 8, 0, false), el_c, el_l, 1);
  el_c
}

/// A surface's six integers.
fn surface_ints(w: WallSurface) -> vector<integer> { [w.ws_dk, w.ws_dm, w.ws_num_k, w.ws_num_m, w.ws_den, w.ws_n] }

/// The L built from its cells BUILDS times; the last one's walls, runs, corners and thin walls.
fn built_op(cells: HexSet) -> vector<integer> {
  bo_ints: vector<integer> = [];
  bo_edges = 0;
  for bj in 0..BUILDS {
    bo_b = cells_built(cells, 9);
    bo_edges += len(bo_b.cw_boundary);
    if bj == BUILDS - 1 {
      bo_ints = [len(bo_b.cw_walls), len(bo_b.cw_boundary)];
      for w in bo_b.cw_walls { bo_ints += surface_ints(w); }
      for run in bo_b.cw_runs { bo_ints += [len(run), run[0] ?? -1]; }
      for c in bo_b.cw_corners { bo_ints += [(c.0 * 1000000.0) as integer, (c.1 * 1000000.0) as integer]; }
      bo_ints += [edgeset_count_all(bo_b.cw_edges), edgeset_digest(bo_b.cw_edges)];
    }
  }
  bo_ints += [bo_edges];
  bo_ints
}

fn bench_built(n: integer) -> Row {
  bb_c0 = ell(0);
  bb_c1 = ell(1);
  bb_t0 = ticks();
  bb_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bb_sink += built_op(bb_c0)[1]?; } else { bb_sink += built_op(bb_c1)[1]?; }
  }
  bb_us = ticks() - bb_t0;
  bb_one = built_op(bb_c0);
  Row { name: "cells_built", iters: n, us: bb_us, px: BUILDS * (bb_one[1] ?? 0),
        hash: fnv(FNV_OFFSET, bb_one), sink: bb_sink }
}

/// A ragged street round a block, as cells: a ring three cells wide whose north and south
/// stretches step over by a row every nine cells, about column `dq`.
fn street(dq: integer) -> HexSet {
  st_c = hexset_chunk(0 - HALF, 0 - HALF, WIN, WIN);
  for st_q in -24..25 {
    st_off = ((st_q + 27) / 9) % 3;
    for st_r in 0..3 {
      hexset_set(st_c, st_q + dq, 14 + st_off + st_r, true);
      hexset_set(st_c, st_q + dq, -18 + st_off + st_r, true);
    }
  }
  for st_r in -18..19 {
    for st_w in 0..3 {
      hexset_set(st_c, -24 + st_w + dq, st_r, true);
      hexset_set(st_c, 22 + st_w + dq, st_r, true);
    }
  }
  st_c
}

/// Every loop of the street's outline, OUTLINES times; the last one's walls and corners.
fn outline_op(cells: HexSet) -> vector<integer> {
  oo_ints: vector<integer> = [];
  oo_walls = 0;
  for oj in 0..OUTLINES {
    oo_os = cells_outlines(cells, 0);
    for o in oo_os { oo_walls += len(o.co_walls); }
    if oj == OUTLINES - 1 {
      oo_ints = [len(oo_os), 0];
      for o in oo_os {
        oo_ints += [len(o.co_walls), len(o.co_boundary)];
        oo_ints[1] += len(o.co_boundary);
        for w in o.co_walls { oo_ints += surface_ints(w); }
        for c in o.co_corners { oo_ints += [(c.0 * 1000000.0) as integer, (c.1 * 1000000.0) as integer]; }
      }
    }
  }
  oo_ints += [oo_walls];
  oo_ints
}

fn bench_outlines(n: integer) -> Row {
  bo_c0 = street(0);
  bo_c1 = street(1);
  bo_t0 = ticks();
  bo_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bo_sink += outline_op(bo_c0)[1]?; } else { bo_sink += outline_op(bo_c1)[1]?; }
  }
  bo_us = ticks() - bo_t0;
  bo_one = outline_op(bo_c0);
  Row { name: "cells_outlines", iters: n, us: bo_us, px: OUTLINES * (bo_one[1] ?? 0),
        hash: fnv(FNV_OFFSET, bo_one), sink: bo_sink }
}

// ── cellopen: doors and windows on the L's walls ────────────────────

const OPENS = 20;

/// Three openings a wall on the built L — a door in its middle, a window a quarter along and one
/// three quarters along — placed and read back, OPENS times; the last reading and its marks.
fn open_op(b: CellWalls, shift: integer) -> vector<integer> {
  op_ints: vector<integer> = [0];
  op_sz = opening_sizes(1.0 + (shift as float) * 0.25, 1.0, 0.8660254037844386);
  op_n = len(b.cw_walls);
  for oj in 0..OPENS {
    op_marks = cells_no_marks(b.cw_cells);
    for op_i in 0..op_n {
      op_a = b.cw_corners[(op_i + op_n - 1) % op_n] ?? (0.0, 0.0);
      op_b = b.cw_corners[op_i] ?? (0.0, 0.0);
      for op_k in 1..4 {
        op_f = (op_k as float) * 0.25;
        cells_place_opening(b, op_marks, if op_k == 2 { OPEN_DOOR } else { OPEN_WINDOW },
                            op_a.0 + (op_b.0 - op_a.0) * op_f, op_a.1 + (op_b.1 - op_a.1) * op_f, op_sz);
      }
    }
    op_found = cells_openings(b.cw_boundary, b.cw_runs, b.cw_walls, op_marks, op_sz);
    op_ints[0] += len(op_found);
    if oj == OPENS - 1 {
      for o in op_found {
        op_ints += [o.op_kind, o.op_wall, len(o.op_edges), o.op_edges[0] ?? -1, (o.op_cx * 1000000.0) as integer,
                    (o.op_cy * 1000000.0) as integer, (o.op_ax * 1000000.0) as integer, (o.op_ay * 1000000.0) as integer,
                    (o.op_bx * 1000000.0) as integer, (o.op_by * 1000000.0) as integer];
      }
      op_ints += [edgeset_count_all(op_marks), edgeset_digest(op_marks)];
    }
  }
  op_ints
}

fn bench_openings(n: integer) -> Row {
  bp_b = cells_built(ell(0), 9);
  bp_t0 = ticks();
  bp_sink = 0;
  for r in 0..n { bp_sink += open_op(bp_b, r & 1)[0]?; }
  bp_us = ticks() - bp_t0;
  Row { name: "cells_openings", iters: n, us: bp_us, px: OPENS * 3 * len(bp_b.cw_walls),
        hash: fnv(FNV_OFFSET, open_op(bp_b, 0)), sink: bp_sink }
}

fn main() {
  mn_n = 20;
  mn_args = arguments();
  mn_i = 0;
  while mn_i < len(mn_args) {
    if mn_args[mn_i]? == "--n" && mn_i + 1 < len(mn_args) {
      mn_n = (mn_args[mn_i + 1]? as integer?)?;
      mn_i += 1;
    }
    mn_i += 1;
  }
  if mn_n < 1 { mn_n = 1; }
  mn_t0 = ticks();
  println("routine\titers\tus\tns_op\tpx\tns_px\thash");
  mn_rows: vector<Row> = [bench_spread(mn_n), bench_built(mn_n), bench_outlines(mn_n), bench_openings(mn_n)];
  mn_sink = 0;
  for row in mn_rows {
    print_row(row);
    mn_sink += row.sink;
  }
  println("time: {(ticks() - mn_t0) / 1000}ms sink={mn_sink}");
}
