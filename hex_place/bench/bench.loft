//
// bench — the performance pass: the package's hot doors, timed on a fixed workload, with a
// hash of what they produced.
//
//     loft --interpret bench/bench.loft [--n N]         the interpreter
//     loft --native-release bench/bench.loft [--n N]    compiled
//     rustc -O --edition=2021 bench/bench.rs -o bench/.build/stats_rs   the Rust twin
//
// One tab-separated line per routine: name, iterations, total µs, ns per op, items one op
// processes (cells swept), ns per item, and an FNV-1a-32 hash of one canonical op's
// output.  The interpreter, the native build and the pure-Rust twin in bench/bench.rs must
// print the same hash for a row, or one of them is not computing the routine it claims to.
//
// Every op starts from the repetition number `r`: `r & 1` picks one of two footprint pairs,
// the second the first moved one column over — the values, never the amount of work — so
// no backend can hoist an op out of the repetition loop.  Each op's result is folded into
// `sink`.
use hex_field::*;
use hex_form::*;
use hex_place::*;

/// One measured routine.
struct Row {
  name: text = "",
  iters: integer = 0,
  us: integer = 0,
  px: integer = 0,
  hash: integer = 0,
  sink: integer = 0,
}

const FNV_OFFSET = 2166136261;
const FNV_PRIME = 16777619;

const CUT_W = 64;
const CUTS = 20;
const UNION_W = 128;
const UNIONS = 10;

/// FNV-1a-32 over the low 32 bits of each integer, high byte first.
fn fnv(h0: integer, v: const vector<integer>) -> integer {
  fv_h = h0;
  for x in v {
    fv_w = x & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 24) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 16) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ ((fv_w >> 8) & 255)) * FNV_PRIME) & 0xFFFFFFFF;
    fv_h = ((fv_h ^ (fv_w & 255)) * FNV_PRIME) & 0xFFFFFFFF;
  }
  fv_h
}

fn print_row(r: const Row) {
  pr_ns = ((r.us * 1000) / r.iters) ?? 0;
  pr_px = if r.px > 0 { (((r.us * 1000) as float) / ((r.iters * r.px) as float)) ?? 0.0 }
          else { 0.0 };
  println("{r.name}\t{r.iters}\t{r.us}\t{pr_ns}\t{r.px}\t{pr_px:.3}\t{r.hash:x}");
}

/// A w x w chunk holding one disk of radius `n` centred on (cq, cr).
fn footprint(w: integer, cq: integer, cr: integer, n: integer) -> HexSet {
  fo_s = hexset_chunk(0, 0, w, w);
  hexdisk_into(fo_s, cq, cr, n);
  fo_s
}

// ── combine_cut: two overlapping footprints, marked then cut once ───

/// CUTS combines into one edge layer; the writes are unconditional, so every pass does
/// the same work whatever the layer already holds.
fn cut_op(a: HexSet, b: HexSet, e: EdgeSet) -> integer {
  co_n = 0;
  for _c in 0..CUTS { co_n += combine_cut(a, 3, b, 5, e); }
  co_n
}

fn cut_hash(a: HexSet, b: HexSet) -> integer {
  ch_e = edgeset_new(0, 0, CUT_W, CUT_W);
  ch_n = combine_cut(a, 3, b, 5, ch_e);
  fnv(FNV_OFFSET, [ch_n, edgeset_count_all(ch_e), edgeset_digest(ch_e)])
}

fn bench_cut(n: integer) -> Row {
  bc_a0 = footprint(CUT_W, 26, 32, 20);
  bc_b0 = footprint(CUT_W, 38, 32, 20);
  bc_a1 = footprint(CUT_W, 27, 32, 20);
  bc_b1 = footprint(CUT_W, 39, 32, 20);
  bc_e = edgeset_new(0, 0, CUT_W, CUT_W);
  bc_t0 = ticks();
  bc_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bc_sink += cut_op(bc_a0, bc_b0, bc_e); }
    else { bc_sink += cut_op(bc_a1, bc_b1, bc_e); }
  }
  bc_us = ticks() - bc_t0;
  Row { name: "combine_cut", iters: n, us: bc_us, px: CUTS * CUT_W * CUT_W,
        hash: cut_hash(bc_a0, bc_b0), sink: bc_sink }
}

// ── field_union: a fresh set, the OR of two ─────────────────────────

fn union_op(a: HexSet, b: HexSet) -> integer {
  uo_n = 0;
  for _u in 0..UNIONS { uo_n += hexset_count(field_union(a, b)); }
  uo_n
}

/// The union's filled-cell count per row, then its total.
fn union_hash(a: HexSet, b: HexSet) -> integer {
  uh_u = field_union(a, b);
  uh_v: vector<integer> = [];
  for uh_r in 0..UNION_W {
    uh_c = 0;
    for uh_q in 0..UNION_W { if hexset_get(uh_u, uh_q, uh_r) { uh_c += 1; } }
    uh_v += [uh_c];
  }
  uh_v += [hexset_count(uh_u)];
  fnv(FNV_OFFSET, uh_v)
}

fn bench_union(n: integer) -> Row {
  bu_a0 = footprint(UNION_W, 50, 64, 40);
  bu_b0 = footprint(UNION_W, 76, 64, 40);
  bu_a1 = footprint(UNION_W, 51, 64, 40);
  bu_b1 = footprint(UNION_W, 77, 64, 40);
  bu_t0 = ticks();
  bu_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bu_sink += union_op(bu_a0, bu_b0); } else { bu_sink += union_op(bu_a1, bu_b1); }
  }
  bu_us = ticks() - bu_t0;
  Row { name: "field_union", iters: n, us: bu_us, px: UNIONS * UNION_W * UNION_W,
        hash: union_hash(bu_a0, bu_b0), sink: bu_sink }
}

// ── cells_turn: a hall turned by 30-degree steps ────────────────────

const TURN_HALF = 40;
const TURN_W = 81;
const TURN_STEPS = 7;

/// A hall as cells: 20 hex steps by 14 about cell (cq, 0), by the exact tests a plan is filled
/// with — a centre within 20 half steps along the row, and within 14 hex steps across it.
fn hall(cq: integer) -> HexSet {
  ha_s = hexset_chunk(0 - TURN_HALF, 0 - TURN_HALF, TURN_W, TURN_W);
  for ha_r in 0 - TURN_HALF..TURN_HALF + 1 {
    for ha_q in 0 - TURN_HALF..TURN_HALF + 1 {
      ha_k = lattice_k(ha_q, ha_r) - lattice_k(cq, 0);
      ha_m = lattice_m(ha_q, ha_r);
      if ha_k >= -20 && ha_k <= 20 && ha_m * ha_m <= 588 { hexset_set(ha_s, ha_q, ha_r, true); }
    }
  }
  ha_s
}

/// The step of the i-th turn: five odd ones and two even.
fn turn_step(i: integer) -> integer {
  if i == 0 { return 1; }
  if i == 1 { return 2; }
  if i == 2 { return 3; }
  if i == 3 { return 5; }
  if i == 4 { return 7; }
  if i == 5 { return 10; }
  11
}

/// The hall turned by each of the seven steps about its own cell: the cells, the offset and a
/// point carried through, and the last turn's cells row by row.
fn turn_op(cells: HexSet, cq: integer) -> vector<integer> {
  to_ints: vector<integer> = [0];
  for ti in 0..TURN_STEPS {
    to_t = cells_turn(cells, cq, 0, turn_step(ti));
    (to_x, to_y) = turned_point(to_t, 3.0, 4.0);
    to_ints[0] += hexset_count(to_t.tn_cells);
    to_ints += [hexset_count(to_t.tn_cells), (to_t.tn_sx * 1000000.0) as integer, (to_t.tn_sy * 1000000.0) as integer,
                (to_x * 1000000.0) as integer, (to_y * 1000000.0) as integer];
    if ti == TURN_STEPS - 1 {
      for to_r in hexset_r0(to_t.tn_cells)..hexset_r0(to_t.tn_cells) + hexset_h(to_t.tn_cells) {
        to_c = 0;
        for to_q in hexset_q0(to_t.tn_cells)..hexset_q0(to_t.tn_cells) + hexset_w(to_t.tn_cells) {
          if hexset_get(to_t.tn_cells, to_q, to_r) { to_c += 1; }
        }
        to_ints += [to_c];
      }
    }
  }
  to_ints
}

fn bench_turn(n: integer) -> Row {
  bt_c0 = hall(0);
  bt_c1 = hall(1);
  bt_t0 = ticks();
  bt_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bt_sink += turn_op(bt_c0, 0)[0]?; } else { bt_sink += turn_op(bt_c1, 1)[0]?; }
  }
  bt_us = ticks() - bt_t0;
  Row { name: "cells_turn", iters: n, us: bt_us, px: TURN_STEPS * hexset_count(bt_c0),
        hash: fnv(FNV_OFFSET, turn_op(bt_c0, 0)), sink: bt_sink }
}

// ── seat_blend: a hall seated on a slope, the ground round it blended ─

const SEATS = 5;

/// Ground sloping up to the east and a little to the north, shifted by `salt`.
fn slope(salt: integer) -> Heights {
  sl_h = heights_new(0 - TURN_HALF, 0 - TURN_HALF, TURN_W, TURN_W);
  for sl_r in 0 - TURN_HALF..TURN_HALF + 1 {
    for sl_q in 0 - TURN_HALF..TURN_HALF + 1 {
      height_set(sl_h, sl_q, sl_r, ((lattice_k(sl_q, sl_r) + salt) as float) * 0.05 + (lattice_m(sl_q, sl_r) as float) * 0.03);
    }
  }
  sl_h
}

/// The hall seated SEATS times, each on fresh ground: the lowest ground under it, and the last
/// ground's heights summed row by row.
fn seat_op(cells: HexSet, salt: integer) -> vector<integer> {
  so_ints: vector<integer> = [0];
  for sj in 0..SEATS {
    so_h = slope(salt);
    so_low = seat_blend(cells, so_h, 2.0, 3.0, 1.5);
    so_ints[0] += (so_low * 1000000.0) as integer;
    so_ints += [(so_low * 1000000.0) as integer];
    if sj == SEATS - 1 {
      for so_r in 0 - TURN_HALF..TURN_HALF + 1 {
        so_sum = 0.0;
        for so_q in 0 - TURN_HALF..TURN_HALF + 1 { so_sum += height_get(so_h, so_q, so_r); }
        so_ints += [(so_sum * 1000000.0) as integer];
      }
    }
  }
  so_ints
}

fn bench_seat(n: integer) -> Row {
  bs_c0 = hall(0);
  bs_c1 = hall(1);
  bs_t0 = ticks();
  bs_sink = 0;
  for r in 0..n {
    if (r & 1) == 0 { bs_sink += seat_op(bs_c0, 0)[0]?; } else { bs_sink += seat_op(bs_c1, 1)[0]?; }
  }
  bs_us = ticks() - bs_t0;
  Row { name: "seat_blend", iters: n, us: bs_us, px: SEATS * TURN_W * TURN_W,
        hash: fnv(FNV_OFFSET, seat_op(bs_c0, 0)), sink: bs_sink }
}

fn main() {
  mn_n = 20;
  mn_args = arguments();
  mn_i = 0;
  while mn_i < len(mn_args) {
    if mn_args[mn_i]? == "--n" && mn_i + 1 < len(mn_args) {
      mn_n = (mn_args[mn_i + 1]? as integer?)?;
      mn_i += 1;
    }
    mn_i += 1;
  }
  if mn_n < 1 { mn_n = 1; }
  mn_t0 = ticks();
  println("routine\titers\tus\tns_op\tpx\tns_px\thash");
  mn_rows: vector<Row> = [bench_cut(mn_n), bench_union(mn_n), bench_turn(mn_n), bench_seat(mn_n)];
  mn_sink = 0;
  for row in mn_rows {
    print_row(row);
    mn_sink += row.sink;
  }
  println("time: {(ticks() - mn_t0) / 1000}ms sink={mn_sink}");
}
