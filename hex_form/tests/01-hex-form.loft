// hex_form — the conformance tests: the turtle form, its canonical text, and the byte round trip.
//
// These assert the library's CONTRACT.  The exhaustive measurement lives in hexbody's gates
// (`tests/form.loft`, `tests/text.loft`), which print their evidence and carry a control that must
// fire.  This is what CI runs under `LOFT_DENY_WARNINGS=1`.
use hex_form::*;
use hex_field::*;

fn main() {
  f = form_new(0, [1, 1, 1], [4, 4, 4]);            // an equilateral triangle
  assert(len(f.fm_len) == 3, "a triangle has three sides");
}

fn test_a_closed_form_is_admissible_and_fills() {
  f = form_new(0, [1, 1, 1], [4, 4, 4]);
  assert(form_admissible(f), "the equilateral triangle is admissible");
  cells = hexset_chunk(-10, -10, 21, 21);
  n = form_fill(f, 0, 0, cells);
  assert(n == 3, "the len-1 triangle fills 3 cells, got {n}");
}

fn test_the_text_round_trips_byte_for_byte() {
  f = form_new(0, [1, 2, 1, 2], [3, 3, 3, 3]);
  t = form_write(f, "house");
  g = form_read(t);
  assert(form_eq(f, g), "read(write(f)) = f");
  assert(form_write(g, "house") == t, "and the bytes match exactly");
}

fn test_the_canonical_text_is_start_corner_invariant() {
  // The same cycle written from its three corners collapses to one canonical text -- this is
  // what makes a project file diffable: two authors of the same shape produce the same bytes.
  // A corner shift rotates the side and turn lists and advances h0 by the turns it skipped;
  // this cycle is fully periodic, so the lists come back unchanged and h0 alone moves.
  a = form_new(0, [1, 1, 1], [4, 4, 4]);
  b = form_new(4, [1, 1, 1], [4, 4, 4]);
  c = form_new(8, [1, 1, 1], [4, 4, 4]);
  assert(form_write(a, "s") != form_write(b, "s"), "three corners, three texts");
  assert(form_canon_text(a, "s") == form_canon_text(b, "s"), "one shape, one canonical text");
  assert(form_canon_text(a, "s") == form_canon_text(c, "s"), "from every corner");
}

fn test_a_non_closing_walk_is_refused() {
  // turns that do not sum to a full revolution do not close -- and an open walk is not a form.
  f = form_new(0, [1, 1, 1], [4, 4, 5]);
  assert(!form_admissible(f), "a walk whose turns miss closure is refused");
}

// The dot product of two doubled vectors, exact: a vector with itself is `vec_n2_4`, a step and
// its perpendicular give 0, and two headings three steps apart are at a right angle.
fn test_the_dot_product_is_exact() {
  for h in 0..HEAD_N {
    a = head_step(h);
    b = head_step(h + 3);
    assert(vec_dot_4(a.0, a.1, a.0, a.1) == vec_n2_4(a.0, a.1), "heading {h}: a step with itself is its length squared");
    assert(vec_dot_4(a.0, a.1, perp_k(a.0, a.1), perp_m(a.0, a.1)) == 0, "heading {h}: a step and its perpendicular");
    assert(vec_dot_4(a.0, a.1, b.0, b.1) == 0, "heading {h} and {h + 3}: a right angle");
    c = head_step(h + 6);
    assert(vec_dot_4(a.0, a.1, c.0, c.1) == 0 - vec_n2_4(a.0, a.1), "heading {h} and its opposite");
  }
}

// The sign of a + b*sqrt(3) against the float it stands for, and where a float could not say:
// 7 - 4*sqrt(3) is 0.0718 (49 against 48), 26 - 15*sqrt(3) is 0.019 (676 against 675).
fn test_the_sign_of_a_plus_b_root3() {
  assert(sign_root3(0, 0) == 0, "0 is 0");
  assert(sign_root3(7, -4) == 1 && sign_root3(-7, 4) == -1, "7 - 4*sqrt(3) > 0");
  assert(sign_root3(5, -3) == -1 && sign_root3(-5, 3) == 1, "5 - 3*sqrt(3) < 0");
  assert(sign_root3(26, -15) == 1 && sign_root3(-26, 15) == -1, "26 - 15*sqrt(3) > 0");
  assert(sign_root3(1351, -780) == 1, "1351 - 780*sqrt(3) > 0, by 0.00037");
  for a in -9..10 {
    for b in -9..10 {
      v = (a as float) + (b as float) * 1.7320508075688772;
      want = if v > 0.0 { 1 } else if v < 0.0 { -1 } else { 0 };
      assert(sign_root3(a, b) == want, "the sign of {a} + {b}*sqrt(3)");
    }
  }
}
